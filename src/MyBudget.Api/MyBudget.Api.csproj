<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- A library, not a service: the endpoints are hosted in-process by the desktop app, and by the
         tests over an in-memory transport. There is no entry point, no appsettings and no port. -->
    <Description>ASP.NET Core minimal API endpoints, hosted in-process by the desktop app.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../MyBudget.Domain/MyBudget.Domain.csproj" />
    <ProjectReference Include="../MyBudget.Contracts/MyBudget.Contracts.csproj" />
    <ProjectReference Include="../MyBudget.Data/MyBudget.Data.csproj" />
    <ProjectReference Include="../MyBudget.Engines.Ledger/MyBudget.Engines.Ledger.csproj" />
    <ProjectReference Include="../MyBudget.Engines.Paycheck/MyBudget.Engines.Paycheck.csproj" />
    <ProjectReference Include="../MyBudget.Engines.Hsa/MyBudget.Engines.Hsa.csproj" />
    <ProjectReference Include="../MyBudget.Engines.Amortization/MyBudget.Engines.Amortization.csproj" />
    <ProjectReference Include="../MyBudget.Engines.Rewards/MyBudget.Engines.Rewards.csproj" />
    <ProjectReference Include="../MyBudget.Engines.Import/MyBudget.Engines.Import.csproj" />
    <ProjectReference Include="../MyBudget.Engines.Investments/MyBudget.Engines.Investments.csproj" />
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <!-- The namespaces the Web SDK used to import implicitly. Declared here so the endpoint files stay
       free of boilerplate now that this is a library rather than a web project. -->
  <ItemGroup>
    <Using Include="Microsoft.AspNetCore.Builder" />
    <Using Include="Microsoft.AspNetCore.Hosting" />
    <Using Include="Microsoft.AspNetCore.Http" />
    <Using Include="Microsoft.AspNetCore.Routing" />
    <Using Include="Microsoft.Extensions.Configuration" />
    <Using Include="Microsoft.Extensions.DependencyInjection" />
    <Using Include="Microsoft.Extensions.Hosting" />
    <Using Include="Microsoft.Extensions.Logging" />
    <Using Include="System.Net.Http.Json" />
  </ItemGroup>
</Project>
