    private void Edit(HoldingDto h) => editing = new() { Id = h.Id, Ticker = h.Ticker, Name = h.Name, AccountId = h.AccountId, Drip = h.Drip, IsActive = h.IsActive, Notes = h.Notes };

    private async Task SaveHolding()
    {
        try { await Api.SaveHoldingAsync(editing!); editing = null; await Load(); }
        catch (Exception ex) { error = ex.Message; }
    }

    private async Task DeleteHolding()
    {
        try { await Api.DeleteHoldingAsync(editing!.Id); editing = null; await Load(); }
        catch (Exception ex) { error = ex.Message; }
    }

    /// <summary>
    /// Sets a sweep to a stated balance. The difference is booked as a trade, the same way an import
    /// does it, so the position lands on the number without a second pot of cash appearing.
    /// </summary>
    private async Task SetCashBalance(PositionDto p)
    {
        if (cashBalance is not { } balance) { error = "Enter the balance first."; return; }
        try
        {
            await Api.SetCashBalanceAsync(p.Holding.Id, balance, cashAsOf ?? DateOnly.FromDateTime(DateTime.Today));
            cashBalance = null; cashAsOf = null;
            await Load();
        }
        catch (Exception ex) { error = ex.Message; }
    }

    private async Task SyncAll()
    {
        syncing = true;
        try { syncResults = await Api.SyncAllHoldingsAsync(); await Load(); }
        catch (Exception ex) { error = ex.Message; }
        finally { syncing = false; }
    }

    private async Task AddTrade(int holdingId)
    {
        if (newTrade.Shares <= 0) return;
        try { newTrade.HoldingId = holdingId; await Api.SaveTradeAsync(newTrade); newTrade = new() { Date = newTrade.Date }; await Load(); }
        catch (Exception ex) { error = ex.Message; }
    }

    private static string KindName(ContributionKind k) => k switch
    {
        ContributionKind.Personal => "You",
        ContributionKind.Employer => "Employer",
        ContributionKind.Rollover => "Rollover",
        _ => "Withdrawal",
    };

    private static ContributionDto NewContribution(int accountId) => new() { AccountId = accountId, Date = DateOnly.FromDateTime(DateTime.Today) };

    private async Task ToggleContributions(int accountId)
    {
        if (contributions?.AccountId == accountId) { contributions = null; return; }
        editingContribution = NewContribution(accountId);
        try { contributions = await Api.GetContributionsAsync(accountId); contributionsFrom = contributions.CoverFrom; }
        catch (Exception ex) { error = ex.Message; }
    }

    private async Task SaveContributionsFrom(int accountId)
    {
        try
        {
            await Api.SetContributionsFromAsync(accountId, contributionsFrom);
            contributions = await Api.GetContributionsAsync(accountId);
            await Load();
        }
        catch (Exception ex) { error = ex.Message; }
    }

    private void EditContribution(ContributionDto c) => editingContribution = new()
    {
        Id = c.Id, AccountId = c.AccountId, Date = c.Date, Amount = c.Amount, Kind = c.Kind, Description = c.Description, Source = c.Source,
    };

    private async Task SaveContribution()
    {
        if (editingContribution.Amount <= 0) { error = "Enter the amount as a positive number; choose Withdrawal for money taken out."; return; }
        try
        {
            await Api.SaveContributionAsync(editingContribution);
            var accountId = editingContribution.AccountId;
            editingContribution = NewContribution(accountId);
            contributions = await Api.GetContributionsAsync(accountId);
            await Load();
        }
        catch (Exception ex) { error = ex.Message; }
    }

    private async Task RemoveContribution(ContributionDto c)
    {
        try
        {
            await Api.DeleteContributionAsync(c.Id);
            if (editingContribution.Id == c.Id) editingContribution = NewContribution(c.AccountId);
            contributions = await Api.GetContributionsAsync(c.AccountId);
            await Load();
        }
        catch (Exception ex) { error = ex.Message; }
    }

    private async Task RemoveTrade(TradeDto t)
    {
        try { await Api.DeleteTradeAsync(t.Id); await Load(); }
        catch (Exception ex) { error = ex.Message; }
    }

    private async Task AddDividend(int holdingId)
    {
        if (newDividend.PerShare <= 0) return;
        try { newDividend.HoldingId = holdingId; await Api.AddDividendAsync(newDividend); newDividend = new() { ExDate = newDividend.ExDate }; await Load(); }
        catch (Exception ex) { error = ex.Message; }
    }

    private async Task RemoveDividend(DividendDto d)
    {
        try { await Api.DeleteDividendAsync(d.Id); await Load(); }
        catch (Exception ex) { error = ex.Message; }
    }

    private async Task SetPrice(string ticker)
    {
        if (manualPrice <= 0) return;
        try { await Api.SetPriceAsync(ticker, DateOnly.FromDateTime(DateTime.Today), manualPrice); await Load(); }
        catch (Exception ex) { error = ex.Message; }
    }
