@page "/settings"
@inject ApiClient Api
@inject MyBudget.UI.Services.IFileSaver Files

<ErrorBanner @bind-Message="error" />

@if (settings is null)
{
    <p class="muted">Loading…</p>
}
else
{
    <section class="panel">
        <h2>Local AI</h2>
        <p class="muted">
            The assistant and the monthly narrative run against a model server you control. Nothing leaves your
            network unless the address you give points off it, and the model never sees the database: it calls a
            fixed set of functions and narrates what they return.
        </p>

        <div class="settings-form">
            <div class="setting">
                <div class="setting-label">
                    <label for="ai-enabled">Enabled</label>
                    <p class="hint">Turn the assistant and the monthly narrative on.</p>
                </div>
                <div class="setting-control">
                    <label class="inline"><input id="ai-enabled" type="checkbox" @bind="settings.AiEnabled" /> Use local AI</label>
                </div>
            </div>

            <div class="setting">
                <div class="setting-label">
                    <label for="ai-url">Address</label>
                    <p class="hint">
                        Ollama's own API, e.g. <code>http://nas.local:11434</code>.
                        An address ending in <code>/v1</code> is treated as OpenAI-compatible instead.
                    </p>
                </div>
                <div class="setting-control">
                    <input id="ai-url" type="url" @bind="settings.AiBaseUrl" placeholder="http://localhost:11434" />
                </div>
            </div>

            <div class="setting">
                <div class="setting-label">
                    <label for="ai-key">API key</label>
                    <p class="hint">
                        Optional. A model server on your own machine usually needs none; anything behind a gateway does.
                        Kept in the local database file and sent only to the address above.
                    </p>
                </div>
                <div class="setting-control">
                    <div class="with-button">
                        <input id="ai-key" type="@(showKey ? "text" : "password")" @bind="settings.AiApiKey" placeholder="none" autocomplete="off" />
                        <button class="secondary" type="button" @onclick="() => showKey = !showKey">@(showKey ? "Hide" : "Show")</button>
                    </div>
                </div>
            </div>

            <div class="setting">
                <div class="setting-label">
                    <label for="ai-style">API style</label>
                    <p class="hint">
                        Ollama's own API and an OpenAI-compatible one use different paths and reply shapes.
                        Leave this on Auto and press Test connection; it sets itself to whatever answers.
                    </p>
                </div>
                <div class="setting-control">
                    <select id="ai-style" @bind="settings.AiApiStyle">
                        <option value="@MyBudget.Domain.AiApiStyle.Auto">Auto (work it out)</option>
                        <option value="@MyBudget.Domain.AiApiStyle.Ollama">Ollama</option>
                        <option value="@MyBudget.Domain.AiApiStyle.OpenAiCompatible">OpenAI-compatible</option>
                    </select>
                </div>
            </div>

            <div class="setting">
                <div class="setting-label">
                    <label for="ai-model">Model</label>
                    <p class="hint">
                        It has to support tool calling. Test the connection and this becomes a list of what's installed.
                    </p>
                </div>
                <div class="setting-control">
                    @if (probe is { Reachable: true, Models.Count: > 0 })
                    {
                        <select id="ai-model" @bind="settings.AiModel">
                            @if (!probe.Models.Contains(settings.AiModel ?? "")) { <option value="@settings.AiModel">@settings.AiModel</option> }
                            @foreach (var m in probe.Models) { <option value="@m">@m</option> }
                        </select>
                    }
                    else
                    {
                        <input id="ai-model" type="text" @bind="settings.AiModel" placeholder="llama3.1" />
                    }
                </div>
            </div>

            <div class="setting">
                <div class="setting-label">
                    <label for="ai-rounds">Tool rounds</label>
                    <p class="hint">How many times it may call functions before it has to answer with what it has.</p>
                </div>
                <div class="setting-control">
                    <input id="ai-rounds" type="number" min="1" max="20" class="narrow" @bind="settings.AiMaxToolRounds" />
                </div>
            </div>
        </div>

        @if (probing)
        {
            <p class="status-line muted">Checking @settings.AiBaseUrl…</p>
        }
        else if (probe is { } p)
        {
            <p class="status-line @(p.Reachable ? "ok" : "bad")">
                <strong>@(p.Reachable ? "Reachable" : "Not reachable")</strong>
                @if (p.Reachable)
                {
                    <text> · @p.Models.Count model@(p.Models.Count == 1 ? "" : "s") available · @(p.Style == MyBudget.Domain.AiApiStyle.Ollama ? "Ollama API" : "OpenAI-compatible API")</text>
                    @if (p.Endpoint is { } ep) { <span class="detail">Chat will post to @ep</span> }
                    @if (ModelMissing(p)) { <span class="detail neg">This server doesn't list "@settings!.AiModel". Pick one from the Model list above, or chat will fail.</span> }
                }
                @if (!string.IsNullOrWhiteSpace(p.Error)) { <span class="detail">@p.Error</span> }
            </p>
        }
        else if (saved)
        {
            <p class="status-line ok"><strong>Saved.</strong> Test the connection to confirm the address answers.</p>
        }

        <div class="actions-row">
            <button class="secondary" type="button" @onclick="Probe" disabled="@probing">Test connection</button>
            <button type="button" @onclick="Save">Save</button>
        </div>
    </section>

    <section class="panel">
        <h2>Back up and restore</h2>
        <p class="muted">
            Your whole budget is one file on this machine. Export it before upgrading, or to hand someone
            their own copy. Restoring replaces everything currently in the app.
        </p>

        @if (backup is { Supported: true } bk)
        {
            <div class="settings-form">
                <div class="setting">
                    <div class="setting-label">
                        <label>Export</label>
                        <p class="hint">
                            Saves a snapshot of everything: accounts, budget, transactions, holdings, settings.
                            It's an ordinary SQLite file, so any database tool can open it.
                        </p>
                    </div>
                    <div class="setting-control">
                        <button class="secondary" type="button" @onclick="Export" disabled="@exporting">@(exporting ? "Exporting…" : "Export budget")</button>
                        @if (exportedTo is { } path) { <p class="hint pos">Saved to @path</p> }
                    </div>
                </div>

                <div class="setting">
                    <div class="setting-label">
                        <label>Restore</label>
                        <p class="hint">
                            Replaces everything in the app with the chosen file. What's here now is copied
                            alongside it first, so a wrong file can be undone. Takes effect when you restart.
                        </p>
                    </div>
                    <div class="setting-control">
                        <InputFile OnChange="OnBudgetFile" accept=".mybudget,.db,.sqlite" />
                    </div>
                </div>

                <div class="setting">
                    <div class="setting-label">
                        <label>This budget</label>
                        <p class="hint">Where the file lives and how big it is.</p>
                    </div>
                    <div class="setting-control">
                        <p class="hint"><code>@bk.DatabasePath</code></p>
                        <p class="hint">@((bk.SizeBytes / 1024.0 / 1024.0).ToString("0.0")) MB</p>
                    </div>
                </div>
            </div>

            @if (bk.RestorePending)
            {
                <p class="status-line ok"><strong>A restore is waiting.</strong> It replaces this budget the next time the app starts.</p>
            }
            @if (importResult is { } ir)
            {
                <p class="status-line @(ir.Ok ? "ok" : "bad")">
                    @if (ir.Ok)
                    {
                        <strong>Ready to restore.</strong>
                        <text> @string.Join(", ", ir.Counts.Select(c => $"{c.Value} {c.Key.ToLowerInvariant()}")). Restart the app to switch to it.</text>
                        @if (ir.ReplacedCopyPath is { } rp) { <span class="detail">The budget being replaced was copied to @rp</span> }
                    }
                    else
                    {
                        <strong>Not restored.</strong>
                        <span class="detail">@ir.Problem</span>
                    }
                </p>
            }
        }
        else
        {
            <p class="muted">Only available for the local database. This app is pointed at a shared API.</p>
        }
    </section>

    <section class="panel">
        <h2>What the assistant can answer</h2>
        @if (status is { Tools.Count: > 0 } st)
        {
            <p class="muted">
                @st.Tools.Count fixed functions. Anything outside them gets "I can't answer that yet" rather than a guess,
                and the model never writes its own query.
            </p>
            <ul class="tool-list">@foreach (var t in st.Tools) { <li><code>@t</code></li> }</ul>
        }
        else { <p class="muted">Save the settings to see the function list.</p> }
    </section>
}

@code {
    private AppSettingsDto? settings;
    private AiProbeDto? probe;
    private AiStatusDto? status;
    private BackupStatusDto? backup;
    private BackupImportDto? importResult;
    private bool probing, saved, showKey, exporting;
    private string? exportedTo;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            settings = await Api.GetAppSettingsAsync();
            status = await Api.GetAiStatusAsync();
            backup = await Api.GetBackupStatusAsync();
        }
        catch (Exception ex) { error = ex.Message; }
    }

    private async Task Export()
    {
        exporting = true; exportedTo = null; error = null;
        try
        {
            var (content, name) = await Api.ExportBudgetAsync();
            exportedTo = await Files.SaveBytesAsync(name, content);
        }
        catch (Exception ex) { error = ex.Message; }
        finally { exporting = false; }
    }

    private async Task OnBudgetFile(InputFileChangeEventArgs e)
    {
        error = null; importResult = null;
        try
        {
            await using var stream = e.File.OpenReadStream(512 * 1024 * 1024);
            importResult = await Api.ImportBudgetAsync(e.File.Name, stream);
            backup = await Api.GetBackupStatusAsync();
        }
        catch (Exception ex) { error = ex.Message; }
    }

    /// <summary>
    /// A model the server doesn't list is the difference between a connection test that passes and a
    /// chat that fails, so it gets called out rather than quietly kept as the selected option.
    /// </summary>
    private bool ModelMissing(AiProbeDto p)
        => p.Models.Count > 0 && !string.IsNullOrWhiteSpace(settings?.AiModel) && !p.Models.Contains(settings!.AiModel!);

    /// <summary>Checks what's typed in, without saving it first.</summary>
    private async Task Probe()
    {
        probing = true; saved = false; probe = null;
        try
        {
            probe = await Api.ProbeAiAsync(settings!.AiBaseUrl, settings.AiApiKey);
            if (probe is { Reachable: true } ok)
            {
                settings.AiApiStyle = ok.Style;
                if (ModelMissing(ok)) settings.AiModel = ok.Models[0];
            }
        }
        catch (Exception ex) { error = ex.Message; }
        finally { probing = false; }
    }

    private async Task Save()
    {
        try
        {
            settings = await Api.SaveAppSettingsAsync(settings!);
            status = await Api.GetAiStatusAsync();
            saved = true; probe = null;
        }
        catch (Exception ex) { error = ex.Message; }
    }
}
