@page "/paycheck-what-if"
@inject ApiClient Api
@using MyBudget.Domain

<ErrorBanner @bind-Message="error" />

@if (sources is null)
{
    <p class="muted">Loading…</p>
}
else if (sources.Count == 0)
{
    <p>No W-2 income source yet. Add one under <a href="income">Admin → Income sources</a> with a salary, a pay schedule, deductions and a W-4.</p>
}
else
{
    <div class="toolbar">
        <label class="inline">Source <select @onchange="OnSourceChanged">
            @foreach (var s in sources) { <option value="@s.Id" selected="@(s.Id == sourceId)">@s.Name</option> }
        </select></label>
        <label class="inline">Pay date <input type="date" value="@date.ToString("yyyy-MM-dd")" @onchange="OnDateChanged" /></label>
        <a class="muted push-left" href="paycheck">See the real check on Paycheck</a>
    </div>

    <section class="panel">
        <h2>Change something, see the check and the year</h2>
        <p class="muted">Nothing here is saved. Blank means "as configured today", and percent fields are whole numbers. What you actually earn and elect is edited under <a href="income">Admin → Income sources</a>.</p>
        <div class="row">
            <div class="field"><label>Annual salary</label><input type="number" step="0.01" @bind="whatIf.AnnualSalary" /></div>
            <div class="field"><label>401(k) %</label><input type="number" step="0.5" @bind="whatIf.Retirement401kPercent" /></div>
            <div class="field"><label>Federal status</label><select @bind="whatIfStatus">
                <option value="">(as configured)</option>
                @foreach (var s in Enum.GetValues<FederalFilingStatus>()) { <option value="@s">@Fmt.Words(s)</option> }
            </select></div>
            <div class="field"><label>Step 2 (two jobs)</label><select @bind="whatIfMultipleJobs"><option value="">(as configured)</option><option value="true">Checked</option><option value="false">Unchecked</option></select></div>
            <div class="field"><label>Step 3 credits / yr</label><input type="number" step="1" @bind="whatIf.DependentCredits" /></div>
            <div class="field"><label>4(a) other income / yr</label><input type="number" step="1" @bind="whatIf.OtherIncome" /></div>
            <div class="field"><label>4(b) deductions / yr</label><input type="number" step="1" @bind="whatIf.Deductions" /></div>
            <div class="field"><label>4(c) extra / check</label><input type="number" step="1" @bind="whatIf.ExtraWithholding" /></div>
            <div class="field"><label>MO extra / check</label><input type="number" step="1" @bind="whatIf.MissouriExtraWithholding" /></div>
        </div>
        @if (estimate is not null && estimate.PreTaxDeductions.Concat(estimate.PostTaxDeductions).Any())
        {
            <div class="row">
                @foreach (var l in estimate.PreTaxDeductions.Concat(estimate.PostTaxDeductions).Where(l => !l.Formula.Contains('%')))
                {
                    var name = l.Name;
                    <div class="field"><label>@name / check <span class="muted">(now @Fmt.Money(l.Amount))</span></label>
                        <input type="number" step="0.01" value="@(whatIf.BenefitAmounts.TryGetValue(name, out var v) ? v.ToString("0.00") : "")" @onchange="e => SetBenefit(name, e)" /></div>
                }
            </div>
        }
        <div class="actions-row">
            <button class="secondary" type="button" @onclick="ResetWhatIf">Reset</button>
            <button type="button" @onclick="RunWhatIf">Compare</button>
        </div>
    </section>

    @if (whatIfResult is { } w)
    {
        <div class="row">
            <section class="panel"><h2>Now</h2><EstimateTable E="w.Baseline" /><p class="muted">Year net @Fmt.Money(w.BaselineYear.Net) · year-end <Money Value="w.BaselineYear.FederalRefundOrOwed" Signed="true" /></p></section>
            <section class="panel"><h2>Scenario</h2><EstimateTable E="w.Scenario" />
                <p class="muted">Year net @Fmt.Money(w.ScenarioYear.Net) · year-end <Money Value="w.ScenarioYear.FederalRefundOrOwed" Signed="true" /></p>
                <p><strong>Per check:</strong> <Money Value="w.Scenario.Net - w.Baseline.Net" Signed="true" /> net · <strong>Per year:</strong> <Money Value="w.ScenarioYear.Net - w.BaselineYear.Net" Signed="true" /> net,
                    <Money Value="w.ScenarioYear.FederalRefundOrOwed - w.BaselineYear.FederalRefundOrOwed" Signed="true" /> year-end</p>
                <Steps Items="w.Scenario.Steps" /></section>
        </div>
    }
}

@code {
    private List<IncomeSourceDto>? sources;
    private int sourceId;
    private DateOnly date = DateOnly.FromDateTime(DateTime.Today);
    private readonly DateOnly today = DateOnly.FromDateTime(DateTime.Today);
    private PaycheckEstimateDto? estimate;
    private WhatIfRequest whatIf = new();
    private string whatIfStatus = "";
    private string whatIfMultipleJobs = "";
    private WhatIfResponse? whatIfResult;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            sources = (await Api.GetIncomeSourcesAsync())
                .Where(s => s.IsActive && s.Type == IncomeSourceType.W2Salary && s.PaySchedules.Count > 0 && (s.EndDate is null || s.EndDate >= today.AddYears(-1)))
                .ToList();
            if (sources.Count > 0) { sourceId = sources[0].Id; await Recalc(); }
        }
        catch (Exception ex) { error = ex.Message; }
    }

    private async Task OnSourceChanged(ChangeEventArgs e) { sourceId = int.Parse((string)e.Value!); await Recalc(); }
    private async Task OnDateChanged(ChangeEventArgs e) { if (DateOnly.TryParse((string?)e.Value, out var d)) { date = d; await Recalc(); } }

    /// <summary>The baseline check, which also supplies the benefit rows the scenario can override.</summary>
    private async Task Recalc()
    {
        estimate = null; whatIfResult = null; error = null;
        try { estimate = await Api.GetPaycheckEstimateAsync(sourceId, date); }
        catch (Exception ex) { error = ex.Message; }
    }

    private void SetBenefit(string name, ChangeEventArgs e)
    {
        if (decimal.TryParse((string?)e.Value, out var v)) whatIf.BenefitAmounts[name] = v; else whatIf.BenefitAmounts.Remove(name);
    }

    private async Task RunWhatIf()
    {
        whatIf.IncomeSourceId = sourceId; whatIf.PayDate = date;
        whatIf.FederalStatus = Enum.TryParse<FederalFilingStatus>(whatIfStatus, out var fs) ? fs : null;
        whatIf.MultipleJobs = bool.TryParse(whatIfMultipleJobs, out var mj) ? mj : null;
        try { whatIfResult = await Api.WhatIfAsync(whatIf); }
        catch (Exception ex) { error = ex.Message; }
    }

    private void ResetWhatIf() { whatIf = new(); whatIfStatus = ""; whatIfMultipleJobs = ""; whatIfResult = null; }
}
