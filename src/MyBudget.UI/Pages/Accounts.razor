@page "/accounts"
@inject ApiClient Api

<ErrorBanner @bind-Message="error" />

@if (accounts is null)
{
    <p class="muted">Loading…</p>
}
else
{
    <div class="toolbar">
        <button type="button" @onclick="() => Edit(new AccountDto())">New account</button>
        <label class="inline"><input type="checkbox" @bind="showInactive" /> Show inactive</label>
    </div>

    <table>
        <thead><tr><th>Name</th><th>Type</th><th>Institution</th><th class="money">Min balance</th><th class="money">Latest balance</th><th>As of</th><th class="money" title="Cash leaving this account this month: bills paid from it, plus bills on cards it pays">This month</th><th>Cadence</th><th class="center" title="Rainy-day fund">RDF</th><th class="center">Active</th><th></th></tr></thead>
        <tbody>
        @foreach (var a in accounts.Where(a => showInactive || a.IsActive))
        {
            <tr class="@(a.IsActive ? "" : "muted")">
                <td>@a.Name <MaskedNumber Value="@a.AccountNumber" /></td>
                <td>@Fmt.Words(a.Type)</td>
                <td>@a.Institution</td>
                <td><Money Value="a.MinimumBalance" /></td>
                <td class="money">@Fmt.Money(a.LatestBalance)</td>
                <td>@Fmt.Date(a.LatestBalanceAsOf)</td>
                <td class="money" title="@a.ThisMonthOutflowDetail">@(a.ThisMonthOutflow > 0 ? Fmt.Money(a.ThisMonthOutflow) : "")</td>
                <td>@Fmt.Words(a.TransferCadence)</td>
                <td class="center">@if (a.IsRainyDayFund) { <span class="tick" title="Part of the rainy-day fund">✓</span> }</td>
                <td class="center">@if (a.IsActive) { <span class="tick">✓</span> } else { <span class="muted">—</span> }</td>
                <td class="actions icons">
                    <button class="link" type="button" title="Edit account" @onclick="() => Edit(a)">✎</button>
                    <button class="link" type="button" title="Balances and transfers" @onclick="() => OpenLedger(a)">⇄</button>
                </td>
            </tr>
        }
        </tbody>
    </table>

    @if (editing is not null)
    {
        <section class="panel">
            <h2>@(editing.Id == 0 ? "New account" : editing.Name)</h2>
            <EditForm Model="editing" OnValidSubmit="Save" class="form">
                <DataAnnotationsValidator />
                <fieldset class="group">
                    <legend>Account</legend>
                    <div class="field"><label>Name</label><InputText @bind-Value="editing.Name" /><ValidationMessage For="() => editing.Name" /></div>
                    <div class="field"><label>Institution</label><InputText @bind-Value="editing.Institution" /></div>
                    <div class="field"><label>Type</label><InputSelect @bind-Value="editing.Type">
                        @foreach (var t in Enum.GetValues<MyBudget.Domain.AccountType>()) { <option value="@t">@Fmt.Words(t)</option> }
                    </InputSelect></div>
                    <div class="field"><label>Account number</label><MaskedInput @bind-Value="editing.AccountNumber" /></div>
                </fieldset>
                <fieldset class="group">
                    <legend>Money rules</legend>
                    <div class="field"><label>Minimum balance to keep</label><InputNumber @bind-Value="editing.MinimumBalance" step="0.01" /></div>
                    <div class="field"><label>Transfers into it</label><InputSelect @bind-Value="editing.TransferCadence">
                        @foreach (var t in Enum.GetValues<MyBudget.Domain.TransferCadence>()) { <option value="@t">@Fmt.Words(t)</option> }
                    </InputSelect></div>
                    <div class="checks">
                        <label class="inline"><InputCheckbox @bind-Value="editing.IsRainyDayFund" /> Part of the rainy-day fund</label>
                        <label class="inline"><InputCheckbox @bind-Value="editing.IsActive" /> Active</label>
                    </div>
                </fieldset>
                <div class="field full"><label>Notes</label><InputTextArea @bind-Value="editing.Notes" rows="2" /></div>
                <div class="actions-row">
                    <button type="submit">Save</button>
                    <button class="secondary" type="button" @onclick="() => editing = null">Cancel</button>
                    @if (editing.Id != 0) { <button class="link danger push-right" type="button" @onclick="DeleteEditing">Delete account</button> }
                </div>
            </EditForm>
        </section>
    }

    @if (ledger is not null)
    {
        <section class="panel">
            <h2>@ledger.Name · balances and transfers</h2>
            <div class="row">
                <div>
                    <h3>Record balance</h3>
                    <EditForm Model="newBalance" OnValidSubmit="SaveBalance">
                        <div class="row">
                            <div class="field"><label>As of</label><InputDate @bind-Value="newBalance.AsOf" /></div>
                            <div class="field"><label>Balance</label><InputNumber @bind-Value="newBalance.Balance" step="0.01" /></div>
                            <div class="field"><label>&nbsp;</label><button type="submit">Save balance</button></div>
                        </div>
                    </EditForm>
                    <table>
                        <thead><tr><th>As of</th><th class="money">Balance</th></tr></thead>
                        <tbody>@foreach (var b in balances) { <tr><td>@Fmt.Date(b.AsOf)</td><td><Money Value="b.Balance" /></td></tr> }</tbody>
                    </table>
                </div>
                <div>
                    <h3>Record transfer in</h3>
                    <EditForm Model="newTransfer" OnValidSubmit="SaveTransfer">
                        <div class="row">
                            <div class="field"><label>Date</label><InputDate @bind-Value="newTransfer.Date" /></div>
                            <div class="field"><label>Amount</label><InputNumber @bind-Value="newTransfer.Amount" step="0.01" /></div>
                            <div class="field"><label>Notes</label><InputText @bind-Value="newTransfer.Notes" /></div>
                            <div class="field"><label>&nbsp;</label><button type="submit">Add transfer</button></div>
                        </div>
                    </EditForm>
                    <table>
                        <thead><tr><th>Date</th><th class="money">Amount</th><th>Notes</th><th></th></tr></thead>
                        <tbody>
                        @foreach (var t in transfers)
                        {
                            <tr><td>@Fmt.Date(t.Date)</td><td><Money Value="t.Amount" /></td><td>@t.Notes</td>
                                <td><button class="secondary" type="button" @onclick="() => RemoveTransfer(t)">✕</button></td></tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
            <button class="secondary" type="button" @onclick="() => ledger = null">Close</button>
        </section>
    }

    @if (rainy is { } rd)
    {
        <section class="panel rainy @rd.Status.ToLowerInvariant()">
            <h2>Rainy-day fund · @rd.MonthsCovered.ToString("0.#") months covered <span class="rainy-badge">@rd.Status</span></h2>
            <p title="@rd.ExpensesFormula"><Money Value="rd.Balance" /> across @(rd.Accounts.Count == 0 ? "no marked accounts" : string.Join(", ", rd.Accounts)) against @Fmt.Money(rd.MonthlyExpenses)/month of expenses · 3–6 month range @Fmt.Money(rd.LowTarget)–@Fmt.Money(rd.HighTarget). <strong>@rd.Verdict</strong></p>
            <p class="muted">Mark any account as part of the fund in its editor (a T-Bill account counts). Hover the sentence for how monthly expenses were computed. Per-account sinking-fund transfer needs with formulas are on the Dashboard.</p>
        </section>
    }

}

@code {
    private List<AccountDto>? accounts;
    private RainyDayDto? rainy;
    private AccountDto? editing;
    private AccountDto? ledger;
    private List<AccountBalanceDto> balances = [];
    private List<TransferDto> transfers = [];
    private AccountBalanceDto newBalance = new() { AsOf = DateOnly.FromDateTime(DateTime.Today) };
    private TransferDto newTransfer = new() { Date = DateOnly.FromDateTime(DateTime.Today) };
    private bool showInactive;
    private string? error;

    protected override Task OnInitializedAsync() => Load();

    private async Task Load()
    {
        try
        {
            accounts = await Api.GetAccountsAsync();
            rainy = await Api.GetRainyDayAsync();
        }
        catch (Exception ex) { error = ex.Message; }
    }

    private void Edit(AccountDto a) { editing = Clone(a); ledger = null; }

    private async Task Save()
    {
        try { await Api.SaveAccountAsync(editing!); editing = null; await Load(); }
        catch (Exception ex) { error = ex.Message; }
    }

    private async Task DeleteEditing()
    {
        try { await Api.DeleteAccountAsync(editing!.Id); editing = null; await Load(); }
        catch (Exception ex) { error = ex.Message; }
    }

    private async Task OpenLedger(AccountDto a)
    {
        editing = null; ledger = a;
        newBalance = new() { AccountId = a.Id, AsOf = DateOnly.FromDateTime(DateTime.Today) };
        newTransfer = new() { AccountId = a.Id, Date = DateOnly.FromDateTime(DateTime.Today) };
        await LoadLedger();
    }

    private async Task LoadLedger()
    {
        try
        {
            balances = await Api.GetAccountBalancesAsync(ledger!.Id);
            transfers = await Api.GetTransfersAsync(ledger.Id);
        }
        catch (Exception ex) { error = ex.Message; }
    }

    private async Task SaveBalance()
    {
        try { await Api.SaveAccountBalanceAsync(ledger!.Id, newBalance); await LoadLedger(); await Load(); }
        catch (Exception ex) { error = ex.Message; }
    }

    private async Task SaveTransfer()
    {
        try { await Api.AddTransferAsync(ledger!.Id, newTransfer); newTransfer = new() { AccountId = ledger.Id, Date = newTransfer.Date }; await LoadLedger(); await Load(); }
        catch (Exception ex) { error = ex.Message; }
    }

    private async Task RemoveTransfer(TransferDto t)
    {
        try { await Api.DeleteTransferAsync(ledger!.Id, t.Id); await LoadLedger(); await Load(); }
        catch (Exception ex) { error = ex.Message; }
    }

    private static AccountDto Clone(AccountDto a) => new()
    {
        Id = a.Id, Name = a.Name, Institution = a.Institution, Type = a.Type, AccountNumber = a.AccountNumber, MinimumBalance = a.MinimumBalance,
        TransferCadence = a.TransferCadence, IsRainyDayFund = a.IsRainyDayFund, Notes = a.Notes, IsActive = a.IsActive,
    };
}
