@page "/accounts"
@inject ApiClient Api

<ErrorBanner @bind-Message="error" />

@if (accounts is null)
{
    <p class="muted">Loading…</p>
}
else
{
    <div class="toolbar">
        <button type="button" @onclick="() => Edit(new AccountDto())">New account</button>
        <label class="inline"><input type="checkbox" @bind="showInactive" /> Show inactive</label>
    </div>

    <table>
        <thead><tr><th>Name</th><th>Type</th><th>Institution</th><th class="money">Min balance</th><th class="money" title="Latest snapshot plus transfers since it">Balance</th><th>Snapshot</th><th class="money" title="Cash leaving this account this month: lines paid from it, plus lines on cards it pays">This month</th><th>Cadence</th><th class="center" title="Rainy-day fund">RDF</th><th class="center">Active</th><th></th></tr></thead>
        <tbody>
        @foreach (var a in accounts.Where(a => showInactive || a.IsActive))
        {
            <tr class="@(a.IsActive ? "" : "muted")">
                <td>@a.Name <MaskedNumber Value="@a.AccountNumber" /></td>
                <td>@MyBudget.Domain.AccountTypes.Display(a.Type)</td>
                <td>@a.Institution</td>
                <td><Money Value="a.MinimumBalance" /></td>
                <td class="money" title="@a.BalanceDetail">@Fmt.Money(a.LatestBalance)</td>
                <td class="muted">@Fmt.Date(a.LatestBalanceAsOf)</td>
                <td class="money" title="@a.ThisMonthOutflowDetail">@(a.ThisMonthOutflow > 0 ? Fmt.Money(a.ThisMonthOutflow) : "")</td>
                <td>@Fmt.Words(a.TransferCadence)</td>
                <td class="center">@if (a.IsRainyDayFund) { <span class="tick" title="Part of the rainy-day fund">✓</span> }</td>
                <td class="center">@if (a.IsActive) { <span class="tick">✓</span> } else { <span class="muted">—</span> }</td>
                <td class="actions icons">
                    <button class="link" type="button" title="Edit account" @onclick="() => Edit(a)">✎</button>
                    <button class="link" type="button" title="Balances and transfers" @onclick="() => OpenLedger(a)">⇄</button>
                </td>
            </tr>
        }
        </tbody>
    </table>

    @if (editing is not null)
    {
        @* Over the page, not appended below a long table where it opens out of view. *@
        <Modal Title="@(editing.Id == 0 ? "New account" : editing.Name)" OnClose="() => editing = null">
            <ChildContent>
            <EditForm Model="editing" OnValidSubmit="Save" class="form" id="accounts-form">
                <DataAnnotationsValidator />
                <fieldset class="group">
                    <legend>Account</legend>
                    <div class="field"><label>Name</label><InputText @bind-Value="editing.Name" /><ValidationMessage For="() => editing.Name" /></div>
                    <div class="field"><label>Institution</label><InputText @bind-Value="editing.Institution" /></div>
                    <div class="field"><label>Type</label><InputSelect @bind-Value="editing.Type">
                        @foreach (var t in Enum.GetValues<MyBudget.Domain.AccountType>()) { <option value="@t">@MyBudget.Domain.AccountTypes.Display(t)</option> }
                    </InputSelect></div>
                    <div class="field"><label>Account number</label><MaskedInput @bind-Value="editing.AccountNumber" /></div>
                </fieldset>
                <fieldset class="group">
                    <legend>Money rules</legend>
                    <div class="field"><label>Minimum balance to keep</label><InputNumber @bind-Value="editing.MinimumBalance" step="0.01" /></div>
                    <div class="field"><label>Transfers into it</label><InputSelect @bind-Value="editing.TransferCadence">
                        @foreach (var t in Enum.GetValues<MyBudget.Domain.TransferCadence>()) { <option value="@t">@Fmt.Words(t)</option> }
                    </InputSelect></div>
                    <div class="checks">
                        <label class="inline"><InputCheckbox @bind-Value="editing.IsRainyDayFund" /> Part of the rainy-day fund</label>
                        <label class="inline"><InputCheckbox @bind-Value="editing.IsActive" /> Active</label>
                    </div>
                </fieldset>
                <div class="field full"><label>Notes</label><InputTextArea @bind-Value="editing.Notes" rows="2" /></div>
            </EditForm>
            </ChildContent>
            <Footer>
                @if (editing.Id != 0) { <button class="link danger" type="button" @onclick="DeleteEditing">Delete account</button> }
                <button class="secondary" type="button" @onclick="() => editing = null">Cancel</button>
                <button type="submit" form="accounts-form">Save</button>
            </Footer>
        </Modal>
    }

    @if (ledger is not null)
    {
        <section class="panel">
            <h2>@ledger.Name · statement balances</h2>
            <p class="muted">A statement balance is a point you reconcile to, not a movement. The balance shown everywhere else is the latest one of these plus the transactions since. Money moving in or out is a transaction: enter it on <a href="transactions">Transactions</a>.</p>
            <div class="form">
                <fieldset class="group">
                    <legend>@(balances.Count == 0 ? "Starting balance" : "Statement balance")</legend>
                    <div class="field"><label>Date</label><input type="date" @bind="entryDate" /></div>
                    <div class="field"><label>Balance</label><input type="number" step="0.01" class="narrow-money" @bind="entryAmount" /></div>
                    <div class="field"><label>Notes</label><input type="text" @bind="entryNotes" /></div>
                    <div class="field"><label>&nbsp;</label><button type="button" @onclick="SaveEntry">Save</button></div>
                </fieldset>
            </div>
            <table class="compact ledger-history">
                <thead><tr><th>Date</th><th>What</th><th class="money">Amount</th><th>With</th><th>Notes</th><th></th></tr></thead>
                <tbody>
                @foreach (var row in History())
                {
                    <tr>
                        <td>@Fmt.Date(row.Date)</td>
                        <td>@row.Kind</td>
                        <td class="money"><Money Value="row.Amount" Signed="@(row.Kind.StartsWith("Transfer"))" /></td>
                        <td class="muted">@row.With</td>
                        <td class="muted">@row.Notes</td>
                        <td class="actions">@if (row.Transfer is { } t) { <a class="link" href="@($"transactions?focus={t.Id}")" title="Transfers are edited on Transactions">open</a> }</td>
                    </tr>
                }
                </tbody>
            </table>
            <div class="actions-row"><button class="secondary" type="button" @onclick="() => ledger = null">Close</button></div>
        </section>
    }

    @if (rainy is { } rd)
    {
        <section class="panel rainy @rd.Status.ToLowerInvariant()">
            <h2>Rainy-day fund · @rd.MonthsCovered.ToString("0.#") months covered <span class="rainy-badge">@rd.Status</span></h2>
            <p title="@rd.ExpensesFormula"><Money Value="rd.Balance" /> across @(rd.Accounts.Count == 0 ? "no marked accounts" : string.Join(", ", rd.Accounts)) against @Fmt.Money(rd.MonthlyExpenses)/month of expenses · 3–6 month range @Fmt.Money(rd.LowTarget)–@Fmt.Money(rd.HighTarget). <strong>@rd.Verdict</strong></p>
            <p class="muted">Mark any account as part of the fund in its editor (a T-Bill account counts). Hover the sentence for how monthly expenses were computed. Per-account sinking-fund transfer needs with formulas are on the Dashboard.</p>
        </section>
    }

}

@code {
    private List<AccountDto>? accounts;
    private RainyDayDto? rainy;
    private AccountDto? editing;
    private AccountDto? ledger;
    private List<AccountBalanceDto> balances = [];
    private List<TransferDto> transfers = [];
    private string entryNotes = "";
    private DateOnly entryDate = DateOnly.FromDateTime(DateTime.Today);
    private decimal entryAmount;

    private sealed record HistoryRow(DateOnly Date, string Kind, decimal Amount, string With, string? Notes, TransferDto? Transfer);

    private IEnumerable<HistoryRow> History()
        => balances.Select(b => new HistoryRow(b.AsOf, b.AsOf == balances.Min(x => x.AsOf) ? "Starting balance" : "Statement balance", b.Balance, "", null, null))
            .Concat(transfers.Select(t => new HistoryRow(t.Date, t.Amount >= 0 ? "Transfer in" : "Transfer out", t.Amount, t.CounterpartyName ?? "other", t.Notes, t)))
            .OrderByDescending(r => r.Date).ThenBy(r => r.Kind);

    /// <summary>Only statement balances are recorded here; movements are transactions.</summary>
    private async Task SaveEntry()
    {
        if (ledger is null) return;
        try
        {
            await Api.SaveAccountBalanceAsync(ledger.Id, new AccountBalanceDto { AccountId = ledger.Id, AsOf = entryDate, Balance = entryAmount });
            entryAmount = 0; entryNotes = "";
            await LoadLedger(); await Load();
        }
        catch (Exception ex) { error = ex.Message; }
    }
    private bool showInactive;
    private string? error;

    protected override Task OnInitializedAsync() => Load();

    private async Task Load()
    {
        try
        {
            accounts = await Api.GetAccountsAsync();
            rainy = await Api.GetRainyDayAsync();
        }
        catch (Exception ex) { error = ex.Message; }
    }

    private void Edit(AccountDto a) { editing = Clone(a); ledger = null; }

    private async Task Save()
    {
        try { await Api.SaveAccountAsync(editing!); editing = null; await Load(); }
        catch (Exception ex) { error = ex.Message; }
    }

    private async Task DeleteEditing()
    {
        try { await Api.DeleteAccountAsync(editing!.Id); editing = null; await Load(); }
        catch (Exception ex) { error = ex.Message; }
    }

    private async Task OpenLedger(AccountDto a)
    {
        editing = null; ledger = a; entryAmount = 0; entryNotes = "";
        await LoadLedger();
    }

    private async Task LoadLedger()
    {
        try
        {
            balances = await Api.GetAccountBalancesAsync(ledger!.Id);
            transfers = await Api.GetTransfersAsync(ledger.Id);
        }
        catch (Exception ex) { error = ex.Message; }
    }


    private static AccountDto Clone(AccountDto a) => new()
    {
        Id = a.Id, Name = a.Name, Institution = a.Institution, Type = a.Type, AccountNumber = a.AccountNumber, MinimumBalance = a.MinimumBalance,
        TransferCadence = a.TransferCadence, IsRainyDayFund = a.IsRainyDayFund, Notes = a.Notes, IsActive = a.IsActive,
    };
}
