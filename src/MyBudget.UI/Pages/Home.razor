@page "/"
@inject ApiClient Api
@using MyBudget.Domain

<ErrorBanner @bind-Message="error" />

@if (d is null)
{
    <p class="muted">Loading…</p>
}
else
{
    @if (d.Alerts.Count > 0)
    {
        <section class="panel alerts-panel">
            <button type="button" class="alerts-head @(alertsOpen ? "open" : "")" aria-expanded="@alertsOpen" @onclick="() => alertsOpen = !alertsOpen">
                <span class="caret">@(alertsOpen ? "▾" : "▸")</span>
                <span class="label">Needs attention</span>
                <span class="counts">
                    @if (AlertCount(AlertSeverity.Danger) is > 0 and var dn) { <span class="pill danger">@dn</span> }
                    @if (AlertCount(AlertSeverity.Warning) is > 0 and var wn) { <span class="pill warning">@wn</span> }
                    @if (AlertCount(AlertSeverity.Info) is > 0 and var inf) { <span class="pill">@inf</span> }
                </span>
                @if (!alertsOpen) { <span class="peek muted">@d.Alerts[0].Title@(d.Alerts.Count > 1 ? $" and {d.Alerts.Count - 1} more" : "")</span> }
            </button>
            @if (alertsOpen)
            {
                <ul class="alerts tight">
                    @foreach (var a in d.Alerts)
                    {
                        <li class="alert @a.Severity.ToString().ToLowerInvariant()">
                            <strong>@a.Title</strong> <span class="muted">@a.Detail</span> @if (a.Link is not null) { <a href="@a.Link">open</a> }
                        </li>
                    }
                </ul>
            }
        </section>
    }

    <div class="row tiles">
        <section class="panel tile"><h3>Net worth</h3><p class="big"><Money Value="d.NetWorth" Signed="true" /></p><p class="muted">@(d.NetWorthChange is null ? "" : "vs last month ")@if (d.NetWorthChange is { } nwc) { <Money Value="nwc" Signed="true" /> }</p></section>
        <section class="panel tile"><h3><a href="budget">Spending this month</a></h3><p class="big"><Money Value="d.SpendingThisMonth" /></p><p class="muted">last month <Money Value="d.SpendingLastMonth" /> · <Money Value="d.SpendingThisMonth - d.SpendingLastMonth" Signed="true" />@(d.Uncategorized > 0 ? $" · {d.Uncategorized} uncategorized" : "")</p></section>
        <section class="panel tile"><h3>Next paycheck</h3>@if (d.NextPayDate is { } np) { <p class="big">@Fmt.Date(np.Date)</p><p class="muted">@np.IncomeSource @(np.ThirdCheckOfMonth ? "· third check this month" : "")</p> } else { <p class="muted">No pay schedule.</p> }</section>
        <section class="panel tile rainy @d.RainyDay.Status.ToLowerInvariant()"><h3>Rainy-day fund</h3><p class="big">@d.RainyDay.MonthsCovered.ToString("0.#") months</p><p class="muted" title="@d.RainyDay.ExpensesFormula"><Money Value="d.RainyDay.Balance" /> vs @Fmt.Money(d.RainyDay.LowTarget)–@Fmt.Money(d.RainyDay.HighTarget) · @d.RainyDay.Verdict</p></section>
    </div>

    <div class="row two-up">
    @if (cumulative is { } cs && cs.ThisMonth.Count > 0)
    {
        <section class="panel grow compact-panel">
            <h2>Spending this month vs last</h2>
            <LineChart Series="@SpendSeries(cs)" XAxisLabels="@cs.Days.ToList()" SmoothLines="true" CrosshairTooltip="true"
                       Responsive="true" Width="640" Height="280" Theme="@Palette" Description="@cs.Summary" />
            <p class="muted">@cs.Summary</p>
        </section>
    }
        <section class="panel grow compact-panel">
            <h2>Due in the next 14 days</h2>
            @if (d.UpcomingLines.Count == 0) { <p class="muted">Nothing due.</p> }
            else
            {
                <table class="compact">
                    <thead><tr><th>Due</th><th>Budget line</th><th class="money">Amount</th><th>Paid via</th></tr></thead>
                    <tbody>@foreach (var b in d.UpcomingLines) { <tr><td>@Fmt.Date(b.DueDate)</td><td>@b.LineName @(b.IsAutopay ? "" : "✍")</td><td><Money Value="b.Amount" /></td><td>@b.PaidVia</td></tr> }</tbody>
                    <tfoot><tr><th></th><th>Total</th><th><Money Value="d.UpcomingLines.Sum(b => b.Amount)" /></th><th></th></tr></tfoot>
                </table>
            }
        </section>
    </div>

    <div class="row two-up">
        <section class="panel grow compact-panel">
            <h2>Goals</h2>
            @if (d.Goals.Count == 0) { <p class="muted">No goals yet.</p> }
            else
            {
                <table class="compact">
                    <thead><tr><th>Goal</th><th>Status</th><th>Progress</th></tr></thead>
                    <tbody>@foreach (var g in d.Goals) { <tr title="@g.Formula"><td>@g.Goal.Name</td><td class="@(g.StatusText is "On Track" or "Exceeded" or "Done" ? "pos" : g.StatusText == "Not On Track" ? "neg" : "")">@g.StatusText</td><td><div class="bar"><div class="bar-fill @(g.StatusText == "Not On Track" ? "bad" : "")" style="width:@((int)(g.ProgressFraction * 100))%"></div><div class="bar-mark" style="left:@((int)(g.ElapsedFraction * 100))%"></div></div></td></tr> }</tbody>
                </table>
            }
            <p class="muted"><a href="goals">Goals</a></p>
        </section>

        <section class="panel grow compact-panel">
            <h2>This month in plain English</h2>
        @if (!d.AiEnabled) { <p class="muted">Local AI is off. Turn it on under <a href="settings">Admin → Settings</a> and point it at your Ollama server to get a narrative built from the same numbers above.</p> }
        else
        {
            <div class="toolbar"><button type="button" @onclick="Summarize" disabled="@summarizing">@(summarizing ? "Asking the model…" : "Write this month's summary")</button></div>
            @if (summarizing)
            {
                <p class="muted">Looking up your numbers, then writing the summary. This can take a few minutes.</p>
            }
            @if (summary is { } s)
            {
                <p class="narrative">@s.Narrative</p>
                <details><summary class="muted">What it looked at (@s.ToolCalls.Count tool calls, @s.Model)</summary><ul>@foreach (var t in s.ToolCalls) { <li><code>@(t.Name)(@(t.Arguments))</code></li> }</ul></details>
            }
        }
    </section>
    </div>
}

@code {
    private HomeDashboardDto? d;
    private CumulativeSpendDto? cumulative;
    /// <summary>Collapsed on arrival: the header carries the counts and the first title, so nothing is hidden silently.</summary>
    private bool alertsOpen;
    private AiSummaryDto? summary;
    private bool summarizing;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        try { d = await Api.GetDashboardAsync(); cumulative = await Api.GetCumulativeSpendAsync(); }
        catch (Exception ex) { error = "Could not reach the API: " + ex.Message; }
    }

    /// <summary>This month solid in the accent colour, last month behind it for comparison.</summary>
    private static List<ChartSeries> SpendSeries(CumulativeSpendDto cs) =>
    [
        new() { Label = cs.LastMonthLabel, Color = "#6b7f72", Values = cs.LastMonth.ToList() },
        new() { Label = cs.ThisMonthLabel, Color = "#4fa970", Values = cs.ThisMonth.ToList() },
    ];

    /// <summary>Matches the app's own palette rather than the library's default light theme.</summary>
    private static ChartTheme Palette => new()
    {
        TextColor = "#8a978f",
        GridColor = "#2b342e",
        GridOpacity = 0.9,
        TooltipBackground = "#151a17",
        TooltipTextColor = "#e8efe9",
        Palette = ["#4fa970", "#6b7f72", "#e0a23a", "#ef6b62"],
    };

    private int AlertCount(AlertSeverity s) => d!.Alerts.Count(a => a.Severity == s);

    private async Task Summarize()
    {
        summarizing = true;
        try { summary = await Api.GetAiSummaryAsync(DateTime.Today.Year, DateTime.Today.Month); }
        catch (Exception ex) { error = ex.Message; }
        finally { summarizing = false; }
    }
}
