@page "/transactions"
@inject ApiClient Api
@using MyBudget.Domain

<ErrorBanner @bind-Message="error" />

@if (categories is null || lines is null || accounts is null || cards is null)
{
    <p class="muted">Loading…</p>
}
else
{
    <div class="toolbar">
        <span class="year-nav"><button class="secondary" type="button" @onclick="() => Shift(-1)">‹</button><strong>@(new DateOnly(year, month, 1).ToString("MMM yyyy"))</strong><button class="secondary" type="button" @onclick="() => Shift(1)">›</button></span>
        <label class="inline"><input type="checkbox" @bind="wholeYear" @bind:after="Load" /> Whole year</label>
        <label class="inline"><input type="checkbox" @bind="onlyUncategorized" @bind:after="Load" /> Uncategorized only</label>
        <label class="inline"><input type="checkbox" @bind="onlyUnreconciled" @bind:after="Load" /> Needs reconciling</label>
        <label class="inline">Source <select @bind="sourceFilter" @bind:after="Load"><option value="">all</option>
            @foreach (var a in accounts) { <option value="account:@a.Id">@Fmt.Label(a.Name, a.AccountNumber)</option> }
            @foreach (var c in cards) { <option value="card:@c.Id">@Fmt.Label(c.Name, c.AccountNumber)</option> }</select></label>
        <input type="search" placeholder="Search description" @bind="search" @bind:after="Load" />
        <span class="muted">@(rows?.Count ?? 0) lines · <Money Value="rows?.Where(r => r.Amount < 0 && !r.IsTransfer).Sum(r => r.Amount) ?? 0" Signed="true" /> out</span>
        <button class="secondary" type="button" @onclick="ShowRules">Rules</button>
    </div>

    @if (rulesOpen)
    {
        <section class="panel">
            <h3>Categorization rules <span class="muted">(run in priority order; a match sets category, line, transfer)</span></h3>
            <table class="compact">
                <thead><tr><th>Priority</th><th>Match</th><th>Pattern</th><th>Category</th><th>Label</th><th>Budget line</th><th>Transfer</th><th>Active</th><th></th></tr></thead>
                <tbody>
                @foreach (var r in rules)
                {
                    <tr>
                        <td><input type="number" class="narrow" @bind="r.Priority" /></td>
                        <td><select @bind="r.Match">@foreach (var m in Enum.GetValues<RuleMatch>()) { <option value="@m">@Fmt.Words(m)</option> }</select></td>
                        <td><input type="text" @bind="r.Pattern" /></td>
                        <td><select @bind="r.CategoryId"><option value="">—</option>@foreach (var c in categories) { <option value="@c.Id">@c.Name</option> }</select></td>
                        <td><select @bind="r.LabelId"><option value="">—</option>@foreach (var l in labels ?? []) { <option value="@l.Id">@l.Name</option> }</select></td>
                        <td><select @bind="r.BudgetLineId"><option value="">—</option>@foreach (var b in lines) { <option value="@b.Id">@b.Name</option> }</select></td>
                        <td><input type="checkbox" @bind="r.MarkAsTransfer" /></td>
                        <td><input type="checkbox" @bind="r.IsActive" /></td>
                        <td><button class="secondary" type="button" @onclick="() => SaveRule(r)">Save</button> <button class="secondary" type="button" @onclick="() => DeleteRule(r)">✕</button></td>
                    </tr>
                }
                </tbody>
            </table>
            <div class="toolbar">
                <button class="secondary" type="button" @onclick="() => rules.Add(new CategoryRuleDto())">Add rule</button>
                <button class="secondary" type="button" @onclick="ApplyRules">Re-run all rules on uncategorized lines</button>
                <button class="secondary" type="button" @onclick="() => rulesOpen = false">Close</button>
            </div>
        </section>
    }

    @if (rows is null) { <p class="muted">Loading…</p> }
    else
    {
        <table class="tx">
            <colgroup><col class="c-date" /><col class="c-src" /><col class="c-desc" /><col class="c-amt" /><col class="c-cat" /><col class="c-label" /><col class="c-line" /><col class="c-xfer" /><col class="c-rec" /><col class="c-act" /></colgroup>
            <thead><tr><th>Date</th><th>Source</th><th>Description</th><th class="money">Amount</th><th>Category</th><th>Label</th><th>Budget line</th><th>Transfer</th><th>Rec.</th><th></th></tr></thead>
            <tbody>
            @foreach (var t in rows)
            {
                <tr class="@(t.IsTransfer ? "muted" : "")">
                    <td>@t.Date.ToString("MMM d")</td>
                    <td class="muted ellipsis" title="@t.SourceName">@t.SourceName</td>
                    <td class="ellipsis" title="@t.Description">@(t.Merchant ?? t.Description) @if (t.Origin == MyBudget.Domain.TransactionOrigin.Manual) { <span class="chip small">manual</span> }</td>
                    <td class="money"><Money Value="t.Amount" Signed="true" /></td>
                    <td class="ellipsis">@(t.RepaymentFromPersonName is { } who ? $"Repayment · {who}" : t.CategoryName ?? (t.IsTransfer ? "" : "—"))</td>
                    <td class="ellipsis muted">@t.LabelName</td>
                    <td class="ellipsis">@t.LineName</td>
                    <td class="center muted">@(t.IsTransfer ? "✓" : "")</td>
                    <td class="center">
                        @if (t.ReconciledWithId is not null) { <button class="link ok" type="button" title="@("Reconciled with " + t.ReconciledWithSummary + " · click to unlink")" @onclick="() => Unreconcile(t)">✓</button> }
                        else if (t.Origin == MyBudget.Domain.TransactionOrigin.Manual) { <button class="link warn" type="button" title="Not reconciled with a bank line yet · click to pick one" @onclick="() => OpenReconcile(t)">!</button> }
                        else { <button class="link faint" type="button" title="Link this bank line to an entry you made by hand" @onclick="() => OpenReconcile(t)">⇄</button> }
                    </td>
                    <td class="actions icons"><button class="link" type="button" title="Edit" @onclick="() => StartEdit(t)">✎</button><button class="link" type="button" title="Delete" @onclick="() => Remove(t)">✕</button></td>
                </tr>
            }
            </tbody>
        </table>
    }

    @if (edit is { } et)
    {
        <Modal Title="@(et.Merchant ?? et.Description)" Subtitle="@($"{Fmt.Date(et.Date)} · {et.SourceName} · {Fmt.Money(et.Amount)}")" OnClose="() => edit = null">
            <ChildContent>
            <div class="form">
                <fieldset class="group">
                    <legend>File it under</legend>
                    <div class="field"><label>Category</label><select @bind="editDto.CategoryId"><option value="">—</option>@foreach (var c in categories) { <option value="@c.Id">@c.Name</option> }</select></div>
                    <div class="field"><label>Label <span class="muted">(where)</span></label><select @bind="editDto.LabelId"><option value="">—</option>@foreach (var l in labels ?? []) { <option value="@l.Id">@l.Name</option> }</select></div>
                    <div class="field"><label>BudgetLine it pays</label><select @bind="editDto.BudgetLineId"><option value="">—</option>@foreach (var b in lines) { <option value="@b.Id">@b.Name</option> }</select></div>
                    @if (et.Amount > 0)
                    {
                        <div class="field"><label>Repayment from <span class="muted">(someone who owes you)</span></label><select @bind="editDto.RepaymentFromPersonId"><option value="">—</option>@foreach (var pp in people ?? []) { <option value="@pp.Id">@pp.Name</option> }</select></div>
                    }
                    <div class="checks">
                        <label class="inline"><input type="checkbox" @bind="editDto.IsTransfer" /> Transfer / card payment (not spending)</label>
                        <label class="inline" title="Create a rule so every line with this merchant gets the same category and line, now and in future imports"><input type="checkbox" @bind="editDto.CreateRule" /> Always file "@(et.Merchant ?? et.Description)" this way</label>
                    </div>
                </fieldset>
                <div class="field full"><label>Notes</label><input type="text" @bind="editDto.Notes" /></div>
                <p class="muted small-text">Full description: @et.Description</p>
            </div>
            </ChildContent>
            <Footer>
                <button class="secondary" type="button" @onclick="() => edit = null">Cancel</button>
                <button type="button" @onclick="SaveEdit">Save</button>
            </Footer>
        </Modal>
    }

    @if (reconcileFor is { } rt)
    {
        <Modal Title="@("Reconcile " + (rt.Merchant ?? rt.Description))" Subtitle="@($"{Fmt.Money(rt.Amount)} on {Fmt.Date(rt.Date)} · with {(rt.Origin == MyBudget.Domain.TransactionOrigin.Manual ? "an imported line" : "an entry you made by hand")} on the same account")" OnClose="() => reconcileFor = null">
            <ChildContent>
            <label class="inline small"><input type="checkbox" @bind="showAllCandidates" @bind:after="() => OpenReconcile(rt)" /> show all, not just close amounts</label>
            @if (candidates is null) { <p class="muted">loading…</p> }
            else if (candidates.Count == 0) { <p class="muted">@(showAllCandidates ? "Nothing on this account within 45 days with the same sign." : "No close match; tick \"show all\" to see everything within 45 days.")</p> }
            else
            {
                <table class="compact">
                    <thead><tr><th>Date</th><th>Description</th><th class="money">Amount</th><th>Days apart</th><th class="money">Difference</th><th></th></tr></thead>
                    <tbody>@foreach (var c in candidates) { <tr><td>@Fmt.Date(c.Transaction.Date)</td><td>@c.Transaction.Description</td><td><Money Value="c.Transaction.Amount" Signed="true" /></td><td>@c.DaysApart</td><td class="money">@(c.AmountDifference == 0 ? "exact" : Fmt.Money(c.AmountDifference))</td><td class="actions"><button class="secondary" type="button" @onclick="() => Reconcile(rt, c.Transaction)">Use this</button></td></tr> }</tbody>
                </table>
            }
            </ChildContent>
            <Footer><button class="secondary" type="button" @onclick="() => reconcileFor = null">Close</button></Footer>
        </Modal>
    }
}

@code {
    private int year = DateTime.Now.Year;
    private int month = DateTime.Now.Month;
    private bool wholeYear, onlyUncategorized, onlyUnreconciled, rulesOpen;
    private TransactionDto? reconcileFor;
    private bool showAllCandidates;
    private List<ReconcileCandidateDto>? candidates;
    private string sourceFilter = "", search = "";
    private List<TransactionDto>? rows;
    private List<CategoryDto>? categories;
    private List<BudgetLineDto>? lines;
    private List<AccountDto>? accounts;
    private List<CardDto>? cards;
    private List<PersonDto>? people;
    private List<LabelDto>? labels;
    private List<CategoryRuleDto> rules = [];
    private TransactionDto? edit;
    private TransactionUpdateDto editDto = new();
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        try { categories = await Api.GetCategoriesAsync(); lines = await Api.GetBudgetLinesAsync(); accounts = await Api.GetAccountsAsync(); cards = await Api.GetCardsAsync(); people = await Api.GetPeopleAsync(); labels = await Api.GetLabelsAsync(); }
        catch (Exception ex) { error = ex.Message; }
        await Load();
    }

    private async Task Shift(int delta)
    {
        if (wholeYear) year += delta; else { var d = new DateOnly(year, month, 1).AddMonths(delta); year = d.Year; month = d.Month; }
        await Load();
    }

    private async Task Load()
    {
        var parts = sourceFilter.Split(':');
        int? accountId = parts.Length == 2 && parts[0] == "account" ? int.Parse(parts[1]) : null;
        int? cardId = parts.Length == 2 && parts[0] == "card" ? int.Parse(parts[1]) : null;
        try { rows = await Api.GetTransactionsAsync(year, wholeYear ? null : month, null, onlyUncategorized, search, accountId, cardId, null, onlyUnreconciled); }
        catch (Exception ex) { error = ex.Message; }
    }

    private void StartEdit(TransactionDto t) { edit = t; editDto = new() { CategoryId = t.CategoryId, LabelId = t.LabelId, BudgetLineId = t.BudgetLineId, IsTransfer = t.IsTransfer, Notes = t.Notes, RepaymentFromPersonId = t.RepaymentFromPersonId }; }

    private async Task SaveEdit()
    {
        try { await Api.UpdateTransactionAsync(edit!.Id, editDto); edit = null; await Load(); if (rulesOpen) rules = await Api.GetCategoryRulesAsync(); }
        catch (Exception ex) { error = ex.Message; }
    }

    private async Task Remove(TransactionDto t)
    {
        try { await Api.DeleteTransactionAsync(t.Id); await Load(); }
        catch (Exception ex) { error = ex.Message; }
    }

    private async Task OpenReconcile(TransactionDto t)
    {
        reconcileFor = t; candidates = null;
        try { candidates = await Api.GetReconcileCandidatesAsync(t.Id, showAllCandidates); }
        catch (Exception ex) { error = ex.Message; }
    }

    private async Task Reconcile(TransactionDto t, TransactionDto other)
    {
        try { await Api.ReconcileAsync(t.Id, other.Id); reconcileFor = null; await Load(); }
        catch (Exception ex) { error = ex.Message; }
    }

    private async Task Unreconcile(TransactionDto t)
    {
        try { await Api.UnreconcileAsync(t.Id); await Load(); }
        catch (Exception ex) { error = ex.Message; }
    }

    private async Task ShowRules() { rulesOpen = !rulesOpen; if (rulesOpen) { try { rules = await Api.GetCategoryRulesAsync(); } catch (Exception ex) { error = ex.Message; } } }
    private async Task SaveRule(CategoryRuleDto r) { try { await Api.SaveCategoryRuleAsync(r); rules = await Api.GetCategoryRulesAsync(); } catch (Exception ex) { error = ex.Message; } }
    private async Task DeleteRule(CategoryRuleDto r) { try { if (r.Id != 0) await Api.DeleteCategoryRuleAsync(r.Id); rules.Remove(r); } catch (Exception ex) { error = ex.Message; } }
    private async Task ApplyRules() { try { await Api.ApplyCategoryRulesAsync(); await Load(); } catch (Exception ex) { error = ex.Message; } }
}
