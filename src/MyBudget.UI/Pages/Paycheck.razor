@page "/paycheck"
@inject ApiClient Api
@using MyBudget.Domain

<ErrorBanner @bind-Message="error" />

@if (sources is null)
{
    <p class="muted">Loading…</p>
}
else if (sources.Count == 0)
{
    <p>No W-2 income source yet. Add one under <a href="income">Income</a> with a salary, a pay schedule, deductions, and a W-4.</p>
}
else
{
    <div class="toolbar">
        <label class="inline">Source <select @onchange="OnSourceChanged">
            @foreach (var s in sources) { <option value="@s.Id" selected="@(s.Id == sourceId)">@s.Name</option> }
        </select></label>
        <label class="inline">Pay date <input type="date" value="@date.ToString("yyyy-MM-dd")" @onchange="OnDateChanged" /></label>
        <a class="muted" href="income">Employers, salary, elections and odd checks are edited under Income</a>
        <a class="muted" href="paycheck-what-if">What-if is under Calculators</a>
        <span class="tabs">
            @foreach (var t in new[] { "Estimate", "Year", "Bonus", "Actual stubs", "1099" })
            {
                <button type="button" class="@(tab == t ? "" : "secondary")" @onclick="() => SwitchTab(t)">@t</button>
            }
        </span>
    </div>

    @if (tab == "Estimate")
    {
        @if (estimate is null) { <p class="muted">Calculating…</p> }
        else
        {
            <div class="row">
                <section class="panel">
                    <h2>@Fmt.Date(estimate.PayDate) · @estimate.IncomeSource</h2>
                    @if (estimate.WorkPeriodStart is { } ws && estimate.WorkPeriodEnd is { } we)
                    {
                        @* Which stretch of work the cheque is for. Under live pay it runs to payday
                           itself, so its last days are paid before they are worked. *@
                        <p class="muted">Covers @Fmt.Date(ws) – @Fmt.Date(we) ·
                            @(estimate.PayLagDays == 0 ? "live pay (through payday)" : $"{estimate.PayLagDays} days in arrears")</p>
                    }
                    <p class="muted">@Fmt.Money(estimate.AnnualSalary) ÷ @estimate.PeriodsPerYear checks · W-4: @estimate.W4Summary · MO W-4: @estimate.MoW4Summary · @estimate.TaxYear tables@(estimate.TaxYearVerified ? "" : " (unverified)")</p>
                    <EstimateTable E="estimate" />
                    <Warnings Items="estimate.Warnings" />
                    <Steps Items="estimate.Steps" />
                </section>
                <section class="panel">
                    <h2>Per year</h2>
                    @if (yearEst is null) { <p class="muted">…</p> }
                    else
                    {
                        <table class="estimate">
                            <tbody>
                                <tr><td>Checks</td><td class="money">@yearEst.Checks.Count</td></tr>
                                <tr class="total"><td>Gross</td><td class="money"><Money Value="yearEst.Gross" /></td></tr>
                                <tr><td class="indent">Pre-tax deductions</td><td class="money">−@Fmt.Money(yearEst.PreTax)</td></tr>
                                <tr><td class="indent">Federal income tax</td><td class="money">−@Fmt.Money(yearEst.Federal)</td></tr>
                                <tr><td class="indent">Social Security</td><td class="money">−@Fmt.Money(yearEst.SocialSecurity)</td></tr>
                                <tr><td class="indent">Medicare</td><td class="money">−@Fmt.Money(yearEst.Medicare)</td></tr>
                                <tr><td class="indent">Missouri</td><td class="money">−@Fmt.Money(yearEst.Missouri)</td></tr>
                                <tr><td class="indent">Post-tax deductions</td><td class="money">−@Fmt.Money(yearEst.PostTax)</td></tr>
                                <tr class="total"><td>Net</td><td class="money"><Money Value="yearEst.Net" /></td></tr>
                                <tr class="sub" title="@yearEst.FederalYearEndFormula"><td>Federal year-end</td><td class="money"><Money Value="yearEst.FederalRefundOrOwed" Signed="true" /> <span class="muted">@(yearEst.FederalRefundOrOwed >= 0 ? "refund" : "owed")</span></td></tr>
                            </tbody>
                        </table>
                        <p class="muted">Liability @Fmt.Money(yearEst.FederalLiability) vs withheld @Fmt.Money(yearEst.FederalWithheld). Hover the row for the formula.</p>
                    }
                </section>
            </div>
        }
    }
    else if (tab == "Year")
    {
        @if (yearEst is null) { <p class="muted">Calculating…</p> }
        else
        {
            <section class="panel">
                <h2>@yearEst.Year · @yearEst.IncomeSource · @yearEst.Checks.Count checks</h2>
                <Warnings Items="yearEst.Warnings" />
                <div class="scroll-x">
                <table>
                    <thead><tr><th>Pay date</th><th class="money">Gross</th><th class="money">Pre-tax</th><th class="money">Federal</th><th class="money">Soc. Sec.</th><th class="money">Medicare</th><th class="money">Missouri</th><th class="money">Post-tax</th><th class="money">Net</th></tr></thead>
                    <tbody>
                    @foreach (var c in yearEst.Checks)
                    {
                        <tr class="@(c.Date < today ? "past" : "")"><td>@Fmt.Date(c.Date)</td><td><Money Value="c.Gross" /></td><td><Money Value="c.PreTax" /></td><td><Money Value="c.Federal" /></td><td><Money Value="c.SocialSecurity" /></td><td><Money Value="c.Medicare" /></td><td><Money Value="c.Missouri" /></td><td><Money Value="c.PostTax" /></td><td><Money Value="c.Net" /></td></tr>
                    }
                    </tbody>
                    <tfoot><tr><th>Total</th><th><Money Value="yearEst.Gross" /></th><th><Money Value="yearEst.PreTax" /></th><th><Money Value="yearEst.Federal" /></th><th><Money Value="yearEst.SocialSecurity" /></th><th><Money Value="yearEst.Medicare" /></th><th><Money Value="yearEst.Missouri" /></th><th><Money Value="yearEst.PostTax" /></th><th><Money Value="yearEst.Net" /></th></tr></tfoot>
                </table>
                </div>
                <p title="@yearEst.FederalYearEndFormula">Federal year-end: liability @Fmt.Money(yearEst.FederalLiability), withheld @Fmt.Money(yearEst.FederalWithheld) → <Money Value="yearEst.FederalRefundOrOwed" Signed="true" /> @(yearEst.FederalRefundOrOwed >= 0 ? "refund" : "owed") <span class="muted">(hover for formula)</span></p>
            </section>
        }
    }
    else if (tab == "Bonus")
    {
        <section class="panel">
            <h2>Bonus or other one-time pay</h2>
            <div class="row">
                <div class="field"><label>Amount</label><input type="number" step="0.01" @bind="bonus.Amount" /></div>
                <div class="field"><label>Method</label><select @bind="bonus.Method">
                    <option value="@SupplementalMethod.Flat">Flat 22% (most employers)</option>
                    <option value="@SupplementalMethod.Aggregate">Aggregate (combined with a regular check)</option>
                </select></div>
                <div class="field"><label>Supplemental pay already this year</label><input type="number" step="0.01" @bind="bonus.YtdSupplemental" /></div>
                <div class="field"><label>&nbsp;</label><button type="button" @onclick="RunBonus">Estimate</button></div>
            </div>
            @if (bonusResult is { } b)
            {
                <EstimateTable E="b" />
                <Steps Items="b.Steps" />
            }
        </section>
    }
    else if (tab == "1099")
    {
        @if (se is null) { <p class="muted">Calculating…</p> }
        else
        {
            <Warnings Items="se.Warnings" />
            <div class="row">
                <section class="panel grow">
                    <h2>1099 income @se.Year</h2>
                    <table class="compact"><thead><tr><th>Source</th><th class="money">Received YTD</th></tr></thead>
                        <tbody>@foreach (var s in se.Sources) { <tr><td>@s.Name</td><td><Money Value="s.YearToDate" /></td></tr> }</tbody>
                        <tfoot><tr><th>Total</th><th><Money Value="se.NetProfitYtd" /></th></tr></tfoot></table>
                    <div class="row">
                        <div class="field"><label>Source</label><select @bind="newReceipt.IncomeSourceId">@foreach (var s in se.Sources) { <option value="@s.IncomeSourceId">@s.Name</option> }</select></div>
                        <div class="field"><label>Date</label><input type="date" @bind="newReceipt.Date" /></div>
                        <div class="field"><label>Amount</label><input type="number" step="0.01" class="narrow-money" @bind="newReceipt.Amount" /></div>
                        <div class="field grow"><label>Notes</label><input type="text" @bind="newReceipt.Notes" /></div>
                        <div class="field"><label>&nbsp;</label><button type="button" @onclick="AddReceipt">Add payment received</button></div>
                    </div>
                    @if (receipts is { Count: > 0 })
                    {
                        <table class="compact"><tbody>@foreach (var r in receipts) { <tr><td>@Fmt.Date(r.Date)</td><td>@se.Sources.FirstOrDefault(s => s.IncomeSourceId == r.IncomeSourceId)?.Name</td><td><Money Value="r.Amount" /></td><td class="muted">@r.Notes</td><td><button class="secondary" type="button" @onclick="() => RemoveReceipt(r)">✕</button></td></tr> }</tbody></table>
                    }
                    <h3>Estimated payments made</h3>
                    <div class="row">
                        <div class="field"><label>To</label><select @bind="newPayment.Jurisdiction"><option value="@MyBudget.Domain.Jurisdiction.Federal">IRS</option><option value="@MyBudget.Domain.Jurisdiction.Missouri">Missouri</option></select></div>
                        <div class="field"><label>Date</label><input type="date" @bind="newPayment.Date" /></div>
                        <div class="field"><label>Amount</label><input type="number" step="0.01" class="narrow-money" @bind="newPayment.Amount" /></div>
                        <div class="field"><label>&nbsp;</label><button type="button" @onclick="AddPayment">Add</button></div>
                    </div>
                    @if (payments is { Count: > 0 })
                    {
                        <table class="compact"><tbody>@foreach (var p in payments) { <tr><td>@Fmt.Date(p.Date)</td><td>@p.Jurisdiction</td><td><Money Value="p.Amount" /></td><td><button class="secondary" type="button" @onclick="() => RemovePayment(p)">✕</button></td></tr> }</tbody></table>
                    }
                </section>
                <section class="panel grow">
                    <h2>Set aside @se.SetAsideFraction.ToString("P0") of every 1099 payment</h2>
                    <div class="row">
                        <div class="field"><label>Projected @se.Year net profit <span class="muted">(blank = @se.ProjectionMethod)</span></label><input type="number" step="1" @bind="projected" /></div>
                        <div class="field"><label>&nbsp;</label><button class="secondary" type="button" @onclick="LoadSe">Recalculate</button></div>
                    </div>
                    <table class="estimate">
                        <tbody>
                            <tr><td>Projected net profit</td><td class="money"><Money Value="se.ProjectedAnnual" /></td></tr>
                            <tr><td class="indent">SE earnings (92.35%)</td><td class="money"><Money Value="se.SeEarnings" /></td></tr>
                            <tr><td class="indent">Social Security (12.4%, after W-2 wages @Fmt.Money(se.W2Wages))</td><td class="money"><Money Value="se.SocialSecurityTax" /></td></tr>
                            <tr><td class="indent">Medicare (2.9%)</td><td class="money"><Money Value="se.MedicareTax" /></td></tr>
                            <tr class="sub"><td>Self-employment tax</td><td class="money"><Money Value="se.SelfEmploymentTax" /></td></tr>
                            <tr><td class="indent">Federal income tax at @se.FederalMarginalRate.ToString("P0") marginal</td><td class="money"><Money Value="se.FederalIncomeTax" /></td></tr>
                            <tr><td class="indent">Missouri at @se.MissouriRate.ToString("P1")</td><td class="money"><Money Value="se.MissouriIncomeTax" /></td></tr>
                            <tr class="total"><td>Total</td><td class="money"><Money Value="se.TotalTax" /></td></tr>
                            <tr><td>Paid so far: federal / Missouri</td><td class="money">@Fmt.Money(se.FederalPaid) / @Fmt.Money(se.MissouriPaid)</td></tr>
                            <tr class="total"><td>Remaining: federal / Missouri</td><td class="money">@Fmt.Money(se.FederalRemaining) / @Fmt.Money(se.MissouriRemaining)</td></tr>
                        </tbody>
                    </table>
                    <h3>Quarterly schedule</h3>
                    <table class="compact">
                        <thead><tr><th>Q</th><th>Due</th><th class="money">IRS</th><th class="money">Missouri</th></tr></thead>
                        <tbody>@foreach (var q in se.Schedule) { <tr class="@(q.Past ? "muted" : "")"><td>@q.Quarter</td><td>@Fmt.Date(q.DueDate)@(q.Past ? " (past)" : "")</td><td><Money Value="q.Federal" /></td><td><Money Value="q.Missouri" /></td></tr> }</tbody>
                    </table>
                    <Steps Items="se.Steps" />
                </section>
            </div>
        }
    }
    else if (tab == "Actual stubs")
    {
        <section class="panel">
            <h2>Entered stubs</h2>
            <p class="muted">Type the numbers off a real stub; the estimate should land within $5 of its net. Line names are matched to the estimate's line names, so use the same names as your deductions.</p>
            <div class="toolbar"><button type="button" @onclick="NewStub">Enter a stub for @Fmt.Date(date)</button></div>
            @if (stubs is { Count: > 0 })
            {
                <table>
                    <thead><tr><th>Pay date</th><th>Kind</th><th class="money">Gross</th><th class="money">Net</th><th></th></tr></thead>
                    <tbody>
                    @foreach (var s in stubs)
                    {
                        <tr><td>@Fmt.Date(s.PayDate)</td><td>@s.Kind</td><td><Money Value="s.Gross" /></td><td><Money Value="s.Net" /></td>
                            <td class="actions"><button class="secondary" type="button" @onclick="() => Compare(s)">Compare</button> <button class="secondary" type="button" @onclick="() => EditStub(s)">Edit</button></td></tr>
                    }
                    </tbody>
                </table>
            }
        </section>
        @if (stubEdit is not null)
        {
            <section class="panel">
                <h3>@(stubEdit.Id == 0 ? "New stub" : "Edit stub")</h3>
                <div class="row">
                    <div class="field"><label>Pay date</label><input type="date" @bind="stubEdit.PayDate" /></div>
                    <div class="field"><label>Kind</label><select @bind="stubEdit.Kind">@foreach (var k in Enum.GetValues<PaycheckKind>()) { <option value="@k">@k</option> }</select></div>
                    <div class="field"><label>Gross</label><input type="number" step="0.01" @bind="stubEdit.Gross" /></div>
                    <div class="field"><label>Net</label><input type="number" step="0.01" @bind="stubEdit.Net" /></div>
                    <div class="field grow"><label>Notes</label><input type="text" @bind="stubEdit.Notes" /></div>
                </div>
                <table>
                    <thead><tr><th>Category</th><th>Line</th><th class="money">Amount</th><th></th></tr></thead>
                    <tbody>
                    @foreach (var l in stubEdit.Lines)
                    {
                        <tr>
                            <td><select @bind="l.Category">@foreach (var c in Enum.GetValues<PaycheckLineCategory>()) { <option value="@c">@Fmt.Words(c)</option> }</select></td>
                            <td><input type="text" @bind="l.Name" /></td>
                            <td><input type="number" step="0.01" @bind="l.Amount" /></td>
                            <td><button class="secondary" type="button" @onclick="() => stubEdit.Lines.Remove(l)">✕</button></td>
                        </tr>
                    }
                    </tbody>
                </table>
                <div class="toolbar">
                    <button class="secondary" type="button" @onclick="() => stubEdit.Lines.Add(new PaycheckLineDto { Category = PaycheckLineCategory.Tax })">Add line</button>
                    <button type="button" @onclick="SaveStub">Save</button>
                    <button class="secondary" type="button" @onclick="() => stubEdit = null">Cancel</button>
                    @if (stubEdit.Id != 0) { <button class="secondary danger" type="button" @onclick="DeleteStub">Delete</button> }
                </div>
            </section>
        }
        @if (compare is { } cmp)
        {
            <section class="panel">
                <h3>@Fmt.Date(cmp.Actual.PayDate) · estimate vs stub · net @(cmp.WithinFiveDollars ? "within $5 ✓" : "off by " + Fmt.Money(Math.Abs(cmp.NetVariance)))</h3>
                <table>
                    <thead><tr><th>Line</th><th class="money">Estimated</th><th class="money">Actual</th><th class="money">Actual − est.</th></tr></thead>
                    <tbody>
                    @foreach (var r in cmp.Rows)
                    {
                        <tr class="@(r.Name is "Gross" or "Net" ? "total" : "")"><td>@r.Name</td><td class="money">@Fmt.Money(r.Estimated)</td><td class="money">@Fmt.Money(r.Actual)</td><td>@(r.Variance is { } v ? (MarkupString)$"<span class=\"money {(v == 0 ? "" : Math.Abs(v) > 5 ? "neg" : "")}\">{Fmt.Money(v)}</span>" : (MarkupString)"<span class=\"muted\">—</span>")</td></tr>
                    }
                    </tbody>
                </table>
                <Steps Items="cmp.Estimate.Steps" />
            </section>
        }
    }
}

@code {
    private List<IncomeSourceDto>? sources;
    private int sourceId;
    private DateOnly date = DateOnly.FromDateTime(DateTime.Today);
    private readonly DateOnly today = DateOnly.FromDateTime(DateTime.Today);
    private string tab = "Estimate";
    private PaycheckEstimateDto? estimate;
    private YearEstimateDto? yearEst;
    private SupplementalRequest bonus = new() { Amount = 5_000m };
    private PaycheckEstimateDto? bonusResult;
    private List<PaycheckDto>? stubs;
    private SelfEmploymentDto? se;
    private decimal? projected;
    private List<IncomeReceiptDto>? receipts;
    private List<EstimatedTaxPaymentDto>? payments;
    private IncomeReceiptDto newReceipt = new() { Date = DateOnly.FromDateTime(DateTime.Today) };
    private EstimatedTaxPaymentDto newPayment = new() { Date = DateOnly.FromDateTime(DateTime.Today), Year = DateTime.Today.Year };
    private PaycheckDto? stubEdit;
    private PaycheckCompareDto? compare;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            sources = (await Api.GetIncomeSourcesAsync()).Where(s => s.IsActive && s.Type == IncomeSourceType.W2Salary && s.PaySchedules.Count > 0 && (s.EndDate is null || s.EndDate >= today.AddYears(-1))).ToList();
            if (sources.Count > 0) { sourceId = sources[0].Id; await Recalc(); }
        }
        catch (Exception ex) { error = ex.Message; }
    }

    private async Task OnSourceChanged(ChangeEventArgs e) { sourceId = int.Parse((string)e.Value!); await Recalc(); }
    private async Task OnDateChanged(ChangeEventArgs e) { if (DateOnly.TryParse((string?)e.Value, out var d)) { date = d; await Recalc(); } }
    private async Task SwitchTab(string t) { tab = t; if (t == "Actual stubs" && stubs is null) await LoadStubs(); if (t == "1099" && se is null) await LoadSe(); }

    private async Task LoadSe()
    {
        try
        {
            se = await Api.GetSelfEmploymentAsync(date.Year, projected);
            receipts = await Api.GetReceiptsAsync(date.Year);
            payments = await Api.GetEstimatedPaymentsAsync(date.Year);
            if (newReceipt.IncomeSourceId == 0 && se.Sources.Count > 0) newReceipt.IncomeSourceId = se.Sources[0].IncomeSourceId;
            newPayment.Year = date.Year;
        }
        catch (Exception ex) { error = ex.Message; }
    }

    private async Task AddReceipt() { if (newReceipt.Amount <= 0) return; try { await Api.AddReceiptAsync(newReceipt); newReceipt = new() { Date = newReceipt.Date, IncomeSourceId = newReceipt.IncomeSourceId }; await LoadSe(); } catch (Exception ex) { error = ex.Message; } }
    private async Task RemoveReceipt(IncomeReceiptDto r) { try { await Api.DeleteReceiptAsync(r.Id); await LoadSe(); } catch (Exception ex) { error = ex.Message; } }
    private async Task AddPayment() { if (newPayment.Amount <= 0) return; try { await Api.AddEstimatedPaymentAsync(newPayment); newPayment = new() { Date = newPayment.Date, Year = date.Year, Jurisdiction = newPayment.Jurisdiction }; await LoadSe(); } catch (Exception ex) { error = ex.Message; } }
    private async Task RemovePayment(EstimatedTaxPaymentDto p) { try { await Api.DeleteEstimatedPaymentAsync(p.Id); await LoadSe(); } catch (Exception ex) { error = ex.Message; } }

    private async Task Recalc()
    {
        estimate = null; yearEst = null; bonusResult = null; compare = null; error = null;
        try
        {
            estimate = await Api.GetPaycheckEstimateAsync(sourceId, date);
            yearEst = await Api.GetPaycheckYearAsync(sourceId, date.Year);
        }
        catch (Exception ex) { error = ex.Message; }
    }




    private async Task RunBonus()
    {
        bonus.IncomeSourceId = sourceId; bonus.PayDate = date;
        try { bonusResult = await Api.SupplementalAsync(bonus); }
        catch (Exception ex) { error = ex.Message; }
    }

    private async Task LoadStubs()
    {
        try { stubs = await Api.GetPaychecksAsync(sourceId); }
        catch (Exception ex) { error = ex.Message; }
    }

    private void NewStub()
    {
        compare = null;
        stubEdit = new PaycheckDto { IncomeSourceId = sourceId, PayDate = date, Gross = estimate?.Gross ?? 0 };
        if (estimate is not null)
        {
            foreach (var l in estimate.PreTaxDeductions) stubEdit.Lines.Add(new() { Category = PaycheckLineCategory.PreTaxDeduction, Name = l.Name });
            foreach (var l in new[] { estimate.FederalIncomeTax, estimate.SocialSecurity, estimate.Medicare, estimate.MissouriIncomeTax }) stubEdit.Lines.Add(new() { Category = PaycheckLineCategory.Tax, Name = l.Name });
            foreach (var l in estimate.PostTaxDeductions) stubEdit.Lines.Add(new() { Category = PaycheckLineCategory.PostTaxDeduction, Name = l.Name });
        }
    }

    private void EditStub(PaycheckDto s)
    {
        compare = null;
        stubEdit = new PaycheckDto { Id = s.Id, IncomeSourceId = s.IncomeSourceId, PayDate = s.PayDate, Kind = s.Kind, Gross = s.Gross, Net = s.Net, Notes = s.Notes,
            Lines = s.Lines.Select(l => new PaycheckLineDto { Category = l.Category, Name = l.Name, Amount = l.Amount }).ToList() };
    }

    private async Task SaveStub()
    {
        try { await Api.SavePaycheckAsync(stubEdit!); stubEdit = null; await LoadStubs(); }
        catch (Exception ex) { error = ex.Message; }
    }

    private async Task DeleteStub()
    {
        try { await Api.DeletePaycheckAsync(stubEdit!.Id); stubEdit = null; await LoadStubs(); }
        catch (Exception ex) { error = ex.Message; }
    }

    private async Task Compare(PaycheckDto s)
    {
        stubEdit = null;
        try { compare = await Api.ComparePaycheckAsync(s.Id); }
        catch (Exception ex) { error = ex.Message; }
    }
}
