@page "/reports"
@inject ApiClient Api
@inject IFileSaver Files

<ErrorBanner @bind-Message="error" />

<div class="toolbar">
    <span class="year-nav"><button class="secondary" type="button" @onclick="() => ChangeYear(year - 1)">‹</button><strong>@year</strong><button class="secondary" type="button" @onclick="() => ChangeYear(year + 1)">›</button></span>
    <span class="tabs">
        <button type="button" class="@(tab == "yoy" ? "" : "secondary")" @onclick="@(() => tab = "yoy")">Year over year</button>
        <button type="button" class="@(tab == "nw" ? "" : "secondary")" @onclick="@(() => tab = "nw")">Net worth</button>
        <button type="button" class="@(tab == "assets" ? "" : "secondary")" @onclick="@(() => LoadAssets())">Home & vehicles</button>
        <button type="button" class="@(tab == "export" ? "" : "secondary")" @onclick="@(() => tab = "export")">Export</button>
    </span>
</div>

@if (tab == "yoy")
{
    @if (yoy is null) { <p class="muted">Loading…</p> }
    else
    {
        <section class="panel">
            <h2>Spending by category · @yoy.Year vs @yoy.PriorYear</h2>
            <YoyTable Rows="yoy.Categories" ThisTotal="yoy.CategoriesThisYear" LastTotal="yoy.CategoriesLastYear" Year="yoy.Year" />
        </section>
        <section class="panel">
            <h2>Bills (actuals) · @yoy.Year vs @yoy.PriorYear</h2>
            <YoyTable Rows="yoy.Bills" ThisTotal="yoy.BillsThisYear" LastTotal="yoy.BillsLastYear" Year="yoy.Year" />
        </section>
    }
}
else if (tab == "nw")
{
    @if (nw is null) { <p class="muted">Loading…</p> }
    else
    {
        <div class="row">
            <section class="panel"><h3>Net worth</h3><p class="big"><Money Value="nw.Total" Signed="true" /></p><p class="muted" title="@nw.Formula">accounts <Money Value="nw.Assets" /> · cards <Money Value="nw.Cards" /> · loans <Money Value="nw.Loans" /></p></section>
            <section class="panel grow">
                <h3>Last 24 months</h3>
                <div class="scroll-x">
                <table>
                    <thead><tr><th>Month</th><th class="money">Accounts</th><th class="money">Cards</th><th class="money">Loans</th><th class="money">Net worth</th><th class="money">Change</th></tr></thead>
                    <tbody>
                    @{ decimal? prev = null; }
                    @foreach (var p in nw.History)
                    {
                        <tr><td>@p.Period.ToString("MMM yyyy")</td><td><Money Value="p.Assets" /></td><td><Money Value="p.Cards" /></td><td><Money Value="p.Loans" /></td><td><Money Value="p.Total" Signed="true" /></td>
                            <td>@if (prev is { } pv) { <Money Value="p.Total - pv" Signed="true" /> }</td></tr>
                        prev = p.Total;
                    }
                    </tbody>
                </table>
                </div>
            </section>
        </div>
        <section class="panel">
            <h3>Lines</h3>
            <table><thead><tr><th>Name</th><th>Kind</th><th class="money">Balance</th><th>As of</th></tr></thead>
                <tbody>@foreach (var l in nw.Lines) { <tr><td>@l.Name</td><td class="muted">@l.Kind</td><td><Money Value="l.Balance" Signed="true" /></td><td>@Fmt.Date(l.AsOf)</td></tr> }</tbody></table>
        </section>
    }
}
else if (tab == "assets")
{
    <section class="panel">
        <h2>Home, vehicles and other assets</h2>
        <p class="muted">Valued by hand (no free Zillow/KBB API). The latest value on or before a date feeds net worth.</p>
        <table>
            <thead><tr><th>Asset</th><th>Kind</th><th class="money">Latest value</th><th>As of</th><th></th></tr></thead>
            <tbody>
            @foreach (var a in assets ?? [])
            {
                <tr><td>@a.Name</td><td>@a.Kind</td><td>@Fmt.Money(a.LatestValue)</td><td>@Fmt.Date(a.LatestAsOf)</td>
                    <td class="actions"><button class="secondary" type="button" @onclick="() => valueFor = a">Record value</button> <button class="secondary" type="button" @onclick="() => assetEdit = new AssetDto { Id = a.Id, Name = a.Name, Kind = a.Kind, Notes = a.Notes, IsActive = a.IsActive }">Edit</button></td></tr>
            }
            </tbody>
        </table>
        <div class="toolbar"><button type="button" @onclick="() => assetEdit = new AssetDto()">New asset</button></div>
        @if (valueFor is { } vf)
        {
            <div class="row">
                <div class="field"><label>@vf.Name value as of</label><input type="date" @bind="newValue.AsOf" /></div>
                <div class="field"><label>Value</label><input type="number" step="1" @bind="newValue.Value" /></div>
                <div class="field"><label>&nbsp;</label><button type="button" @onclick="SaveValue">Save</button> <button class="secondary" type="button" @onclick="() => valueFor = null">Close</button></div>
            </div>
        }
        @if (assetEdit is { } ae)
        {
            <div class="row">
                <div class="field"><label>Name</label><input type="text" @bind="ae.Name" /></div>
                <div class="field"><label>Kind</label><select @bind="ae.Kind">@foreach (var k in Enum.GetValues<MyBudget.Domain.AssetKind>()) { <option value="@k">@k</option> }</select></div>
                <div class="field grow"><label>Notes</label><input type="text" @bind="ae.Notes" /></div>
                <div class="field"><label class="inline"><input type="checkbox" @bind="ae.IsActive" /> Active</label></div>
                <div class="field"><label>&nbsp;</label><button type="button" @onclick="SaveAsset">Save</button> <button class="secondary" type="button" @onclick="() => assetEdit = null">Cancel</button> @if (ae.Id != 0) { <button class="secondary danger" type="button" @onclick="DeleteAsset">Delete</button> }</div>
            </div>
        }
    </section>
}
else
{
    <section class="panel">
        <h2>Export to CSV</h2>
        <div class="toolbar">
            <button type="button" @onclick="@(() => Export("transactions", year))">Transactions @year</button>
            <button type="button" @onclick="@(() => Export("bills", year))">Bills grid @year</button>
            <button type="button" @onclick="@(() => Export("accounts", null))">Accounts</button>
        </div>
        @if (saved is not null) { <p class="pos">Saved to @saved</p> }
    </section>
}

@code {
    private int year = DateTime.Today.Year;
    private string tab = "yoy";
    private YearOverYearDto? yoy;
    private NetWorthDto? nw;
    private string? saved, error;
    private List<AssetDto>? assets;
    private AssetDto? assetEdit, valueFor;
    private AssetValueDto newValue = new() { AsOf = DateOnly.FromDateTime(DateTime.Today) };

    private async Task LoadAssets() { tab = "assets"; try { assets = await Api.GetAssetsAsync(); } catch (Exception ex) { error = ex.Message; } }
    private async Task SaveAsset() { try { await Api.SaveAssetAsync(assetEdit!); assetEdit = null; assets = await Api.GetAssetsAsync(); nw = await Api.GetNetWorthAsync(); } catch (Exception ex) { error = ex.Message; } }
    private async Task DeleteAsset() { try { await Api.DeleteAssetAsync(assetEdit!.Id); assetEdit = null; assets = await Api.GetAssetsAsync(); nw = await Api.GetNetWorthAsync(); } catch (Exception ex) { error = ex.Message; } }
    private async Task SaveValue() { try { await Api.SaveAssetValueAsync(valueFor!.Id, newValue); valueFor = null; assets = await Api.GetAssetsAsync(); nw = await Api.GetNetWorthAsync(); } catch (Exception ex) { error = ex.Message; } }

    protected override Task OnInitializedAsync() => Load();

    private async Task Load()
    {
        try { yoy = await Api.GetYearOverYearAsync(year); nw = await Api.GetNetWorthAsync(); }
        catch (Exception ex) { error = ex.Message; }
    }

    private async Task ChangeYear(int y) { year = y; yoy = null; await Load(); }

    private async Task Export(string name, int? y)
    {
        saved = null;
        try
        {
            var csv = await Api.ExportCsvAsync(name, y);
            saved = await Files.SaveTextAsync($"mybudget-{name}{(y is { } yy ? "-" + yy : "")}.csv", csv);
        }
        catch (Exception ex) { error = ex.Message; }
    }
}
