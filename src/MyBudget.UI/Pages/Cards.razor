@page "/cards"
@inject ApiClient Api

<ErrorBanner @bind-Message="error" />

@if (cards is null || summary is null || accounts is null)
{
    <p class="muted">Loading…</p>
}
else
{
    <div class="toolbar"><button type="button" @onclick="() => Edit(new CardDto())">New card</button></div>

    @* One table, not two over the same rows: what a card costs and how it is used answer the same
       question. Short name in the column, everything that was its own thin column on a hover. *@
    <section class="panel">
        <h2>Cards · @DateTime.Today.Year</h2>
        <p class="muted">Cost is the annual fee plus interest if the latest balance were carried all year at the card's APR (promo APR while it lasts). Value is points earned this year at your point value, plus reached thresholds, plus what you get for simply holding it. Worst first.</p>
        <table>
            <thead><tr>
                <th>Card</th>
                <th class="money" title="Annual fee plus a year's interest on the latest balance">Yearly cost</th>
                <th class="money">Rewards YTD</th>
                <th class="money">Thresholds</th>
                <th class="money">Perks</th>
                <th class="money">Net</th>
                <th class="money">Balance</th>
                <th class="money">Util.</th>
                <th title="Statement closes / payment due">Stmt / due</th>
                <th></th>
            </tr></thead>
            <tbody>
            @foreach (var row in CostRows())
            {
                var u = row.Use;
                <tr @key="row.CardId">
                    <td>
                        <span class="tip">@row.Name
                            <span class="tip-box">
                                <b>@row.FullName</b>
                                <span class="tip-grid">
                                    <span>Paid by</span><span>@(u?.PayingAccount ?? "—")</span>
                                    <span>Balance as of</span><span>@(u?.LatestBalanceAsOf is { } d ? Fmt.Date(d) : "no balance recorded")</span>
                                    <span>Est. interest / yr</span><span class="num">@(row.Interest > 0 ? Fmt.Money(row.Interest) : "—")</span>
                                    <span>Annual fee</span><span class="num">@Fmt.Money(row.Fee)</span>
                                    <span>Budget lines / mo</span><span class="num">@Fmt.Money(u?.MonthlyBudgetSpend ?? 0)</span>
                                    <span>Spent this month</span><span class="num">@Fmt.Money(u?.SpentThisMonth ?? 0)</span>
                                    <span>Last month</span><span class="num">@Fmt.Money(u?.SpentLastMonth ?? 0)</span>
                                </span>
                                @if (u is { BudgetLines.Count: > 0 })
                                {
                                    <span class="tip-note">@string.Join(", ", u.BudgetLines)</span>
                                }
                            </span>
                        </span>
                        <MaskedNumber Value="@row.AccountNumber" />
                    </td>
                    <td><Money Value="row.Cost" /></td>
                    <td><Money Value="row.Value" /></td>
                    <td class="money">@(row.Thresholds > 0 ? Fmt.Money(row.Thresholds) : "—")</td>
                    <td class="money">@(row.Perks > 0 ? Fmt.Money(row.Perks) : "—")</td>
                    @* The verdict was the net said twice; the colour carries it and the words are on hover. *@
                    <td class="money @(row.Net < 0 ? "neg" : row.Net == 0 ? "muted" : "pos")" title="@($"{row.Verdict} — {row.Formula}")">@Fmt.Money(row.Net)</td>
                    <td class="money">@Fmt.Money(u?.LatestBalance)</td>
                    <td class="money">@Fmt.Pct(u?.Utilization)</td>
                    <td>@(u is null ? "—" : $"{u.StatementDay} / {u.DueDay}")</td>
                    <td class="actions icons">
                        <button class="link" type="button" title="Edit card" @onclick="() => Edit(cards.First(c => c.Id == row.CardId))">✎</button>
                        <button class="link" type="button" title="Record a statement balance" @onclick="() => OpenBalance(row.CardId)">⇄</button>
                        <button class="link" type="button" title="Earn rates and spend thresholds" @onclick="() => OpenRewards(row.CardId)">★</button>
                    </td>
                </tr>
            }
            </tbody>
            <tfoot><tr>
                <th>All cards</th>
                <th><Money Value="CostRows().Sum(r => r.Cost)" /></th>
                <th><Money Value="CostRows().Sum(r => r.Value)" /></th>
                <th><Money Value="CostRows().Sum(r => r.Thresholds)" /></th>
                <th><Money Value="CostRows().Sum(r => r.Perks)" /></th>
                <th><Money Value="CostRows().Sum(r => r.Net)" Signed="true" /></th>
                <th colspan="4"></th>
            </tr></tfoot>
        </table>
    </section>

    @if (rewardAlerts is { Count: > 0 })
    {
        <details class="panel heads-up">
            <summary><strong>Rewards heads-up</strong> <span class="muted">@rewardAlerts.Count items · status goals and thresholds behind pace</span></summary>
            <ul class="alerts compact">
                @foreach (var a in rewardAlerts) { <li class="alert @a.Severity.ToString().ToLowerInvariant()"><strong>@a.Title</strong> <span class="muted">@a.Detail</span> <a href="rewards">open</a></li> }
            </ul>
        </details>
    }

    @if (balanceFor is { } cid)
    {
        <section class="panel">
            <h3>Record balance · @cards.First(c => c.Id == cid).Name</h3>
            <EditForm Model="newBalance" OnValidSubmit="SaveBalance">
                <div class="row">
                    <div class="field"><label>As of</label><InputDate @bind-Value="newBalance.AsOf" /></div>
                    <div class="field"><label>Balance</label><InputNumber @bind-Value="newBalance.Balance" step="0.01" /></div>
                    <div class="field"><label>&nbsp;</label><button type="submit">Save</button> <button class="secondary" type="button" @onclick="() => balanceFor = null">Close</button></div>
                </div>
            </EditForm>
        </section>
    }

    @if (rewards is { } rw)
    {
        <section class="panel">
            <h3>Rewards · @cards.First(c => c.Id == rw.CardId).Name</h3>
            <div class="row">
                <div class="field"><label>Loyalty program</label><select @bind="rw.LoyaltyProgramId"><option value="">— (cash back / other)</option>@foreach (var p in programs ?? []) { <option value="@p.Id">@p.Name</option> }</select></div>
                <div class="field"><label>Point value ¢ <span class="muted">(blank = program's)</span></label><input type="number" step="0.01" class="narrow" @bind="rw.PointValueCents" /></div>
            </div>
            <h4>Earn rules <span class="muted">(no category = everything else; a label narrows it to where you shopped, and beats a category-only rule)</span></h4>
            <table class="compact">
                <thead><tr><th>Category</th><th>Label</th><th>Points / $</th><th>Annual cap</th><th>From year</th><th>Until year</th><th>Notes</th><th></th></tr></thead>
                <tbody>
                @foreach (var r in rw.EarnRules)
                {
                    <tr>
                        <td><select @bind="r.CategoryId"><option value="">everything else</option>@foreach (var c in categories ?? []) { <option value="@c.Id">@c.Name</option> }</select></td>
                        <td><select @bind="r.LabelId"><option value="">any</option>@foreach (var l in labels ?? []) { <option value="@l.Id">@l.Name</option> }</select></td>
                        <td><input type="number" step="0.5" class="narrow" @bind="r.PointsPerDollar" /></td>
                        <td><input type="number" step="1" class="narrow-money" @bind="r.AnnualSpendCap" /></td>
                        <td><input type="number" class="narrow" placeholder="any" @bind="r.StartYear" /></td>
                        <td><input type="number" class="narrow" placeholder="any" @bind="r.EndYear" /></td>
                        <td><input type="text" @bind="r.Notes" /></td>
                        <td><button class="secondary" type="button" @onclick="() => rw.EarnRules.Remove(r)">✕</button></td>
                    </tr>
                }
                </tbody>
            </table>
            <button class="secondary" type="button" @onclick="() => rw.EarnRules.Add(new EarnRuleDto())">Add earn rule</button>
            <h4>Spend thresholds</h4>
            <h3>Just for holding the card</h3>
            <p class="muted">Benefits with no spend threshold and no loyalty program behind them: a TSA PreCheck or Global Entry credit, a travel credit, free bags. Worth what it saves you in a year, counted against the annual fee.</p>
            <table class="compact">
                <thead><tr><th>Benefit</th><th class="money">Worth / year</th><th>From year</th><th>Until year</th><th>Notes</th><th></th></tr></thead>
                <tbody>
                @foreach (var k in rw.Perks)
                {
                    <tr>
                        <td><input type="text" @bind="k.Description" /></td>
                        <td><input type="number" step="1" class="narrow-money" @bind="k.AnnualValue" /></td>
                        <td><input type="number" class="narrow" placeholder="any" @bind="k.StartYear" /></td>
                        <td><input type="number" class="narrow" placeholder="any" @bind="k.EndYear" /></td>
                        <td><input type="text" @bind="k.Notes" /></td>
                        <td><button class="secondary" type="button" @onclick="() => rw.Perks.Remove(k)">✕</button></td>
                    </tr>
                }
                </tbody>
            </table>
            <button class="secondary" type="button" @onclick="() => rw.Perks.Add(new CardPerkDto())">Add benefit</button>
            <h3>Spend thresholds</h3>
            <table class="compact">
                <thead><tr><th>Calendar-year spend</th><th>Reward</th><th>Description</th><th>Worth $</th><th>Tier (status)</th><th>From year</th><th>Until year</th><th></th></tr></thead>
                <tbody>
                @foreach (var t in rw.Thresholds)
                {
                    <tr>
                        <td><input type="number" step="1" class="narrow-money" @bind="t.Amount" /></td>
                        <td><select @bind="t.RewardKind">@foreach (var k in Enum.GetValues<MyBudget.Domain.ThresholdRewardKind>()) { <option value="@k">@Fmt.Words(k)</option> }</select></td>
                        <td><input type="text" @bind="t.Description" /></td>
                        <td><input type="number" step="1" class="narrow-money" @bind="t.ValueDollars" /></td>
                        <td><input type="text" class="narrow" @bind="t.TierName" /></td>
                        <td><input type="number" class="narrow" placeholder="any" @bind="t.StartYear" /></td>
                        <td><input type="number" class="narrow" placeholder="any" @bind="t.EndYear" /></td>
                        <td><button class="secondary" type="button" @onclick="() => rw.Thresholds.Remove(t)">✕</button></td>
                    </tr>
                }
                </tbody>
            </table>
            <button class="secondary" type="button" @onclick="() => rw.Thresholds.Add(new SpendThresholdDto())">Add threshold</button>
            <div class="actions-row">
                    <span class="muted push-left">A status threshold also needs a matching card-spend path on the program. Holding this card can also grant status in a program it isn't tied to: add a <em>hold card</em> path there. <a href="loyalty-programs">Admin → Loyalty programs</a>.</span>
                    <button class="secondary" type="button" @onclick="() => rewards = null">Close</button>
                    <button type="button" @onclick="SaveRewards">Save rewards</button>
                </div>
        </section>
    }

    @if (editing is not null)
    {
        @* Over the page rather than appended to the bottom of it: an editor that opens below a long
           table is off-screen at the moment it opens. *@
        <Modal Title="@(editing.Id == 0 ? "New card" : editing.Display)" OnClose="() => editing = null">
            <ChildContent>
            <EditForm Model="editing" OnValidSubmit="Save" class="form" id="card-form">
                <DataAnnotationsValidator />
                <fieldset class="group">
                    <legend>Card</legend>
                    <div class="field span2"><label>Name</label><InputText @bind-Value="editing.Name" /><ValidationMessage For="() => editing.Name" /></div>
                    <div class="field"><label>Short name <span class="muted">(for tables)</span></label><InputText @bind-Value="editing.Nickname" placeholder="e.g. Wells Fargo" /></div>
                    <div class="field"><label>Issuer</label><InputText @bind-Value="editing.Issuer" /></div>
                    <div class="field"><label>Network</label><InputText @bind-Value="editing.Network" /></div>
                    <div class="field"><label>Card number</label><MaskedInput @bind-Value="editing.AccountNumber" /></div>
                </fieldset>
                <fieldset class="group">
                    <legend>Terms</legend>
                    <div class="field"><label>APR %</label><InputNumber @bind-Value="editing.Apr" step="0.01" /></div>
                    <div class="field"><label>Promo APR %</label><InputNumber @bind-Value="editing.PromoApr" step="0.01" /></div>
                    <div class="field"><label>Promo expires</label><OptionalDate @bind-Value="editing.PromoAprExpires" Empty="no promo" /></div>
                    <div class="field"><label>Credit limit</label><InputNumber @bind-Value="editing.CreditLimit" step="0.01" /></div>
                    <div class="field"><label>Annual fee</label><InputNumber @bind-Value="editing.AnnualFee" step="0.01" /></div>
                    <div class="field"><label>Fee posts in month (1–12)</label><InputNumber @bind-Value="editing.AnnualFeeMonth" /></div>
                    <div class="field">
                        <label>Fee in the budget</label>
                        <label class="inline"><InputCheckbox @bind-Value="editing.BudgetAnnualFee" /> Keep a budget line</label>
                        <span class="hint">Filed under Fees · Credit Card. Deleting the line unticks this.</span>
                    </div>
                </fieldset>
                <fieldset class="group">
                    <legend>Statement and payment</legend>
                    <div class="field"><label>Statement closes on day</label><InputNumber @bind-Value="editing.StatementDay" /></div>
                    <div class="field"><label>Payment due on day</label><InputNumber @bind-Value="editing.DueDay" /></div>
                    <div class="field"><label>Paid from account</label><InputSelect @bind-Value="editing.PayingAccountId">
                        <option value="">—</option>
                        @foreach (var a in accounts.Where(a => a.IsActive)) { <option value="@a.Id">@Fmt.Label(a.Name, a.AccountNumber)</option> }
                    </InputSelect></div>
                    <div class="checks"><label class="inline"><InputCheckbox @bind-Value="editing.IsActive" /> Active</label></div>
                </fieldset>
                <div class="field full"><label>Notes</label><InputTextArea @bind-Value="editing.Notes" rows="2" /></div>
            </EditForm>
            </ChildContent>
            <Footer>
                @if (editing.Id != 0) { <button class="link danger" type="button" @onclick="DeleteEditing">Delete card</button> }
                <button class="secondary" type="button" @onclick="() => editing = null">Cancel</button>
                <button type="submit" form="card-form">Save</button>
            </Footer>
        </Modal>
    }
}

@code {
    private List<CardDto>? cards;
    private List<CardSummaryDto>? summary;
    private List<AccountDto>? accounts;
    private CardDto? editing;
    private int? balanceFor;
    private List<LoyaltyProgramDto>? programs;
    private List<CategoryDto>? categories;
    private List<LabelDto>? labels;
    private CardRewardsDto? rewards;
    private RewardsReportDto? report;
    private List<AlertDto>? rewardAlerts;

    /// <summary>
    /// One card, costs and usage together. They were two tables over the same seven rows, which meant
    /// answering "is this card worth keeping?" by reading one table against the other.
    /// </summary>
    private sealed record CostRow(int CardId, string Name, string FullName, string? AccountNumber,
        decimal Fee, decimal Interest, decimal Cost, decimal Value, decimal Thresholds, decimal Perks, decimal Net,
        string Verdict, string Formula, CardSummaryDto? Use);

    private IEnumerable<CostRow> CostRows()
    {
        if (cards is null) return [];
        var today = DateOnly.FromDateTime(DateTime.Today);
        return cards.Where(c => c.IsActive).Select(c =>
        {
            var apr = c.PromoApr is { } promo && (c.PromoAprExpires is null || c.PromoAprExpires >= today) ? promo : c.Apr;
            var balance = c.LatestBalance ?? 0m;
            var interest = Math.Round(Math.Max(0, balance) * apr / 100m, 2);
            var e = report?.Earnings.FirstOrDefault(x => x.CardId == c.Id);
            var value = e?.YtdDollars ?? 0m;
            var thresholds = e?.ThresholdRewardsValue ?? 0m;
            var perks = e?.PerksValue ?? 0m;
            var cost = c.AnnualFee + interest;
            var net = value + thresholds + perks - cost;
            var verdict = cost == 0 && value == 0 && perks == 0 ? "free, unused" : net < 0 ? (value == 0 ? "costing you, no rewards recorded" : "costing more than it returns") : net == 0 ? "break-even" : "earning its keep";
            var formula = $"fee {c.AnnualFee:C} + {balance:C} × {apr:0.##}% = {cost:C} cost; {value:C} rewards" + (thresholds > 0 ? $" + {thresholds:C} thresholds" : "") + (perks > 0 ? $" + {perks:C} perks for holding it" : "") + $" → {net:C}";
            return new CostRow(c.Id, c.Display, c.Name, c.AccountNumber, c.AnnualFee, interest, cost, value, thresholds, perks, net,
                verdict, formula, summary?.FirstOrDefault(x => x.CardId == c.Id));
        }).OrderBy(r => r.Net).ThenByDescending(r => r.Cost);
    }
    private CardBalanceDto newBalance = new();
    private string? error;

    protected override Task OnInitializedAsync() => Load();

    private async Task Load()
    {
        try
        {
            cards = await Api.GetCardsAsync();
            summary = await Api.GetCardSummaryAsync();
            accounts = await Api.GetAccountsAsync();
            programs = await Api.GetLoyaltyProgramsAsync();
            categories = await Api.GetCategoriesAsync();
            labels = await Api.GetLabelsAsync();
            report = await Api.GetRewardsReportAsync(DateTime.Today.Year);
            rewardAlerts = await Api.GetAlertsAsync("rewards");
        }
        catch (Exception ex) { error = ex.Message; }
    }

    private async Task OpenRewards(int cardId)
    {
        editing = null; balanceFor = null;
        try { rewards = await Api.GetCardRewardsAsync(cardId); }
        catch (Exception ex) { error = ex.Message; }
    }

    private async Task SaveRewards()
    {
        try { rewards = await Api.SaveCardRewardsAsync(rewards!); await Load(); }
        catch (Exception ex) { error = ex.Message; }
    }

    private void Edit(CardDto c)
    {
        balanceFor = null; rewards = null;
        editing = new()
        {
            Id = c.Id, Name = c.Name, Nickname = c.Nickname, Issuer = c.Issuer, Network = c.Network, AccountNumber = c.AccountNumber, Apr = c.Apr, PromoApr = c.PromoApr,
            PromoAprExpires = c.PromoAprExpires, StatementDay = c.StatementDay, DueDay = c.DueDay, CreditLimit = c.CreditLimit,
            AnnualFee = c.AnnualFee, AnnualFeeMonth = c.AnnualFeeMonth, PayingAccountId = c.PayingAccountId, Notes = c.Notes, IsActive = c.IsActive,
            BudgetAnnualFee = c.BudgetAnnualFee, FeeBudgetLineId = c.FeeBudgetLineId,
        };
    }

    private void OpenBalance(int cardId)
    {
        editing = null; balanceFor = cardId;
        newBalance = new() { CardId = cardId, AsOf = DateOnly.FromDateTime(DateTime.Today) };
    }

    private async Task SaveBalance()
    {
        try { await Api.SaveCardBalanceAsync(balanceFor!.Value, newBalance); balanceFor = null; await Load(); }
        catch (Exception ex) { error = ex.Message; }
    }

    private async Task Save()
    {
        try { await Api.SaveCardAsync(editing!); editing = null; await Load(); }
        catch (Exception ex) { error = ex.Message; }
    }

    private async Task DeleteEditing()
    {
        try { await Api.DeleteCardAsync(editing!.Id); editing = null; await Load(); }
        catch (Exception ex) { error = ex.Message; }
    }
}
