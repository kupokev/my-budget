@page "/import"
@inject ApiClient Api
@using MyBudget.Domain

<ErrorBanner @bind-Message="error" />

@if (accounts is null || cards is null || profiles is null || categories is null || lines is null || labels is null)
{
    <p class="muted">Loading…</p>
}
else
{
    <section class="panel">
        <p class="muted">Statements and brokerage tax-lot exports both go here. The file decides which
        is which — pick where it came from, choose the file, and the right importer runs.</p>
        <div class="row">
            <div class="field"><label>This file belongs to</label>
                <select @bind="source">
                    <option value="">—</option>
                    <optgroup label="Bank accounts">@foreach (var a in accounts.Where(a => a.IsActive)) { <option value="account:@a.Id">@Fmt.Label(a.Name, a.AccountNumber)</option> }</optgroup>
                    <optgroup label="Cards">@foreach (var c in cards.Where(c => c.IsActive)) { <option value="card:@c.Id">@Fmt.Label(c.Display, c.AccountNumber)</option> }</optgroup>
                </select></div>
            <div class="field"><label>Layout</label>
                <select @bind="profile"><option value="auto">Detect from the file</option>@foreach (var p in profiles) { <option value="@p.Key">@p.Name</option> }</select></div>
            <div class="field"><label>File (.csv, .ofx, .qfx)</label><InputFile OnChange="OnFile" accept=".csv,.ofx,.qfx,.txt" /></div>
        </div>
        @if (busy) { <p class="muted">Reading…</p> }
    </section>

    @if (lotResult is { } lr)
    {
        <section class="panel">
            <h2>@fileName · tax lots</h2>
            <p>@lr.HoldingsCreated new holdings, @lr.LotsImported lots imported, @lr.LotsAlreadyPresent already there, @lr.PricesRecorded prices recorded@(lr.FeesRecorded > 0 ? $", {lr.FeesRecorded} fees recorded" : "") into @lr.AccountName: @string.Join(", ", lr.Tickers).</p>
            <p class="muted">Then fetched @lr.PricesFetched more prices and @lr.DividendsFetched dividends, so the figures are populated without a second click. See them on <a href="investments">Investments</a>.</p>
            @if (lr.FetchErrors is { Count: > 0 } fe) { <ul class="warnings">@foreach (var fx in fe) { <li>@fx</li> }</ul> }
            @if (lr.Skipped.Count > 0) { <p class="muted">Skipped: @string.Join("; ", lr.Skipped)</p> }
            <Warnings Items="lr.Warnings" />
        </section>
    }

    @if (preview is { } pv)
    {
        <section class="panel">
            <h2>@fileName · @pv.SourceName · @pv.ProfileName</h2>
            <p class="muted">@pv.Rows.Count lines from @Fmt.Date(pv.FirstDate) to @Fmt.Date(pv.LastDate): <strong>@pv.NewCount new</strong>, @pv.DuplicateCount already imported. Fix categories here or later on Transactions; a match to a line fills that month's actual.</p>
            <Warnings Items="pv.Warnings" />
            <div class="toolbar">
                <button type="button" @onclick="Commit" disabled="@(pv.NewCount == 0)">Import @pv.Rows.Count(r => !r.IsDuplicate && !r.Skip) lines</button>
                <label class="inline"><input type="checkbox" @bind="hideDupes" /> Hide duplicates</label>
            </div>
            <div class="scroll-x">
            <table class="grid">
                <thead><tr><th>Date</th><th>Description</th><th>Merchant</th><th class="money">Amount</th><th>Budget line</th><th>Category</th><th>Label</th><th>Transfer</th><th>Skip</th></tr></thead>
                <tbody>
                @foreach (var r in pv.Rows.Where(r => !hideDupes || !r.IsDuplicate))
                {
                    <tr class="@(r.IsDuplicate ? "muted" : "")">
                        <td>@Fmt.Date(r.Date)</td>
                        <td title="@r.Memo">@r.Description</td>
                        <td class="muted" title="@r.SuggestionSource">@r.Merchant</td>
                        <td><Money Value="r.Amount" Signed="true" /></td>
                        @* The budget line leads: it already knows its category, and often its label.
                           Picking one fills both in, and where the line has no label of its own the
                           column offers the ones belonging to its category — Amazon or Costco under
                           General Merchandise. *@
                        <td>@if (!r.IsDuplicate) { <select @bind="r.BudgetLineId" @bind:after="() => LineChosen(r)"><option value="">—</option>@foreach (var b in lines.Where(b => b.IsActive)) { <option value="@b.Id">@b.Name</option> }</select> }</td>
                        @{ var chosen = lines.FirstOrDefault(b => b.Id == r.BudgetLineId); }

                        @* Where the budget line settles a field, it is shown rather than offered: an
                           editable dropdown invites a row that disagrees with its own budget line. *@
                        <td>
                            @if (r.IsDuplicate) { }
                            else if (chosen?.CategoryId is { } fromLine)
                            {
                                <span class="muted" title="From the budget line">@(categories.FirstOrDefault(c => c.Id == fromLine)?.Name)</span>
                            }
                            else
                            {
                                <select @bind="r.CategoryId" @bind:after='() => OfferToSpread(r, "category")'><option value="">—</option>@foreach (var c in categories.Where(c => c.IsActive)) { <option value="@c.Id">@c.Name</option> }</select>
                            }
                        </td>
                        <td>
                            @if (r.IsDuplicate) { }
                            else if (chosen?.LabelId is { } lineLabel)
                            {
                                <span class="muted" title="From the budget line">@(labels.FirstOrDefault(l => l.Id == lineLabel)?.Name)</span>
                            }
                            else if (r.CategoryId is not null)
                            {
                                @* A label narrows a category, so without one there is nothing to narrow. *@
                                <select @bind="r.LabelId" @bind:after='() => OfferToSpread(r, "label")'><option value="">—</option>@foreach (var l in LabelChoices.For(labels, r.CategoryId, r.LabelId)) { <option @key="l.Id" value="@l.Id">@l.Name</option> }</select>
                            }
                        </td>
                        <td>@if (!r.IsDuplicate) { <input type="checkbox" @bind="r.IsTransfer" /> }</td>
                        <td>@if (r.IsDuplicate) { <span class="muted">dup</span> } else { <input type="checkbox" @bind="r.Skip" /> }</td>
                    </tr>

                    @if (spread is { } sp && ReferenceEquals(sp.Row, r))
                    {
                        @* Under the row you just changed. Scrolling back to a bar at the top costs you
                           your place in a list of hundreds. *@
                        <tr class="spread-row">
                            <td colspan="9">
                                <span class="row">
                                    <span><strong>@sp.Merchant</strong> → @sp.What. Apply to the other @sp.Count row@(sp.Count == 1 ? "" : "s") from this merchant?</span>
                                    <label class="inline"><input type="checkbox" @bind="spreadRemember" /> Remember for future imports</label>
                                    <button type="button" @onclick="ApplySpread">Apply</button>
                                    <button class="secondary" type="button" @onclick="() => spread = null">No</button>
                                </span>
                            </td>
                        </tr>
                    }
                }
                </tbody>
            </table>
            </div>
        </section>
    }

    @if (result is { } res)
    {
        <section class="panel">
            <h2>Imported</h2>
            <p>@res.Imported lines imported, @res.Duplicates duplicates skipped, @res.Skipped skipped by you, @res.Reconciled reconciled with entries you'd made by hand. @res.BudgetMonthsUpdated line-month actuals updated. Card spend figures follow the transactions, so they need no separate update.</p>
        </section>
    }

    <section class="panel">
        <h2>Previous imports</h2>
        @if (batches is { Count: > 0 })
        {
            <table>
                <thead><tr><th>When</th><th>File</th><th>Source</th><th>Layout</th><th>Lines</th><th>Imported</th><th>Dupes</th><th>Range</th><th></th></tr></thead>
                <tbody>
                @foreach (var b in batches)
                {
                    <tr><td>@b.ImportedAt.ToString("MMM d, yyyy HH:mm")</td><td>@b.FileName</td><td>@b.SourceName</td><td>@b.Profile</td><td>@b.RowCount</td><td>@b.ImportedCount</td><td>@b.DuplicateCount</td>
                        <td>@Fmt.Date(b.FirstDate) – @Fmt.Date(b.LastDate)</td>
                        <td><button class="secondary danger" type="button" @onclick="() => Undo(b)">Undo</button></td></tr>
                }
                </tbody>
            </table>
        }
        else { <p class="muted">None yet.</p> }
    </section>
}

@code {
    private List<AccountDto>? accounts;
    private List<CardDto>? cards;
    private List<ImportProfileDto>? profiles;
    private List<CategoryDto>? categories;
    private List<BudgetLineDto>? lines;
    private List<ImportBatchDto>? batches;
    private string source = "";
    private string profile = "auto";
    private string fileName = "";
    private bool busy, hideDupes = true;
    private List<LabelDto>? labels;
    private ImportPreviewDto? preview;

    /// <summary>
    /// A budget line already knows its category, and often its label. Choosing one fills both in, so
    /// the common case is a single click; where the line has no label the column is left for you to
    /// pick from that category's labels.
    /// </summary>
    private void LineChosen(ImportRowDto row)
    {
        if (lines?.FirstOrDefault(b => b.Id == row.BudgetLineId) is { } line)
        {
            row.CategoryId = line.CategoryId;
            if (line.LabelId is not null) row.LabelId = line.LabelId;
            else if (row.LabelId is { } current && labels?.FirstOrDefault(l => l.Id == current)?.CategoryId != line.CategoryId)
                row.LabelId = null;      // a label from the old category would be wrong here
        }

        OfferToSpread(row, "budget line");
    }

    private sealed record Spread(ImportRowDto Row, string Merchant, string What, int Count, int? CategoryId, int? LabelId, int? BudgetLineId, string Field);
    private Spread? spread;
    private bool spreadRemember = true;

    /// <summary>
    /// After a row is categorised by hand, offers to carry it to the rest of that merchant's rows. The
    /// offer is skipped when nothing else would change, so it appears only when it saves work.
    /// </summary>
    private void OfferToSpread(ImportRowDto row, string field)
    {
        spread = null;
        if (preview is not { } pv || string.IsNullOrWhiteSpace(row.Merchant)) return;

        var same = pv.Rows.Where(r => !r.IsDuplicate && !ReferenceEquals(r, row)
                                      && string.Equals(r.Merchant, row.Merchant, StringComparison.OrdinalIgnoreCase)).ToList();
        if (same.Count == 0) return;

        var differ = field switch
        {
            "category" => same.Count(r => r.CategoryId != row.CategoryId),
            "label" => same.Count(r => r.LabelId != row.LabelId),
            _ => same.Count(r => r.BudgetLineId != row.BudgetLineId || r.CategoryId != row.CategoryId || r.LabelId != row.LabelId),
        };
        if (differ == 0) return;

        var what = field switch
        {
            "category" => categories?.FirstOrDefault(c => c.Id == row.CategoryId)?.Name ?? "no category",
            "label" => labels?.FirstOrDefault(l => l.Id == row.LabelId)?.Name ?? "no label",
            _ => lines?.FirstOrDefault(b => b.Id == row.BudgetLineId)?.Name ?? "no budget line",
        };

        spread = new Spread(row, row.Merchant!, what, differ, row.CategoryId, row.LabelId, row.BudgetLineId, field);
    }

    /// <summary>
    /// Applies the choice to every other row from that merchant, and optionally records a rule so the
    /// next import arrives already categorised rather than repeating this.
    /// </summary>
    private async Task ApplySpread()
    {
        if (spread is not { } sp || preview is not { } pv) return;

        foreach (var r in pv.Rows.Where(r => !r.IsDuplicate && string.Equals(r.Merchant, sp.Merchant, StringComparison.OrdinalIgnoreCase)))
        {
            switch (sp.Field)
            {
                case "category": r.CategoryId = sp.CategoryId; break;
                case "label": r.LabelId = sp.LabelId; break;
                default:
                    // A budget line carries its category and label with it, so spreading it spreads all three.
                    r.BudgetLineId = sp.BudgetLineId;
                    r.CategoryId = sp.CategoryId;
                    r.LabelId = sp.LabelId;
                    break;
            }
        }

        if (spreadRemember)
        {
            try
            {
                await Api.SaveCategoryRuleAsync(new CategoryRuleDto
                {
                    Pattern = sp.Merchant,
                    Match = RuleMatch.Contains,
                    CategoryId = sp.CategoryId,
                    LabelId = sp.LabelId,
                    BudgetLineId = sp.BudgetLineId,
                    IsActive = true,
                });
            }
            catch (Exception ex) { error = $"Rows updated, but the rule could not be saved: {ex.Message}"; }
        }

        spread = null;
    }
    private LotImportResultDto? lotResult;
    private string kind = "Statement";
    private ImportResultDto? result;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            accounts = await Api.GetAccountsAsync(); cards = await Api.GetCardsAsync(); profiles = await Api.GetImportProfilesAsync();
            categories = await Api.GetCategoriesAsync(); labels = await Api.GetLabelsAsync(); lines = await Api.GetBudgetLinesAsync(); batches = await Api.GetImportBatchesAsync();
        }
        catch (Exception ex) { error = ex.Message; }
    }

    private (int? accountId, int? cardId) Source()
    {
        var parts = source.Split(':');
        if (parts.Length != 2) return (null, null);
        var id = int.Parse(parts[1]);
        return parts[0] == "account" ? (id, null) : (null, id);
    }

    /// <summary>
    /// One upload box for both kinds of file. The API is asked what the file is rather than guessing
    /// from the account, because a brokerage account hands you both cash statements and lot exports.
    /// </summary>
    private async Task OnFile(InputFileChangeEventArgs e)
    {
        error = null; result = null; preview = null; lotResult = null;
        var (accountId, cardId) = Source();
        if (accountId is null && cardId is null) { error = "Pick the account or card first."; return; }
        busy = true;
        try
        {
            fileName = e.File.Name;

            await using (var probe = e.File.OpenReadStream(20 * 1024 * 1024))
            {
                kind = (await Api.DetectImportKindAsync(fileName, probe)).Kind;
            }

            if (kind == "TaxLots")
            {
                if (accountId is null)
                {
                    error = "Tax lots belong to an investment account, not a card.";
                    return;
                }
                await using var lotStream = e.File.OpenReadStream(20 * 1024 * 1024);
                lotResult = await Api.ImportLotsAsync(fileName, lotStream, accountId.Value);
                return;
            }

            await using var stream = e.File.OpenReadStream(20 * 1024 * 1024);
            preview = await Api.PreviewImportAsync(fileName, stream, accountId, cardId, profile);
        }
        catch (Exception ex) { error = ex.Message; }
        finally { busy = false; }
    }

    private async Task Commit()
    {
        if (preview is null) return;
        var (accountId, cardId) = Source();
        try
        {
            result = await Api.CommitImportAsync(new ImportCommitRequest { FileName = fileName, Profile = preview.Profile, AccountId = accountId, CardId = cardId, Rows = preview.Rows.Where(r => !r.IsDuplicate).ToList() });
            preview = null;
            batches = await Api.GetImportBatchesAsync();
        }
        catch (Exception ex) { error = ex.Message; }
    }

    private async Task Undo(ImportBatchDto b)
    {
        try { await Api.DeleteImportBatchAsync(b.Id); batches = await Api.GetImportBatchesAsync(); }
        catch (Exception ex) { error = ex.Message; }
    }
}
