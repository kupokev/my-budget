@page "/loans"
@inject ApiClient Api
@using MyBudget.Domain

<ErrorBanner @bind-Message="error" />

@if (loans is null || lines is null || assets is null)
{
    <p class="muted">Loading…</p>
}
else
{
    <div class="toolbar">
        <button type="button" @onclick="() => Edit(new LoanDto { StartDate = DateOnly.FromDateTime(DateTime.Today) })">New loan</button>
        <label class="inline"><input type="checkbox" @bind="showInactive" /> Show inactive</label>
    </div>
    <table>
        <thead>
            <tr>
                <th>Loan</th><th>Kind</th><th>Secured against</th>
                <th class="money">Rate</th><th class="money">Payment</th>
                <th class="money">Latest balance</th><th>As of</th>
                <th class="center">Active</th><th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var l in loans.Where(l => showInactive || l.IsActive))
        {
            <tr class="@(l.IsActive ? "" : "muted")">
                <td>
                    <span class="tip">@l.Name
                        <span class="tip-box">
                            <span class="tip-head"><b>@l.Name</b><span class="chip small">@Fmt.Words(l.Kind)</span></span>
                            <span class="tip-grid">
                                <span>Lender</span><span>@(string.IsNullOrWhiteSpace(l.Lender) ? "—" : l.Lender)</span>
                                @if (!string.IsNullOrWhiteSpace(l.AccountNumber)) { <span>Account #</span><span>@l.AccountNumber</span> }
                                <span>Original</span><span class="num">@Fmt.Money(l.OriginalPrincipal)</span>
                                <span>Rate</span><span class="num">@l.AnnualRatePercent.ToString("0.###")%</span>
                                <span>Term</span><span class="num">@l.TermMonths months</span>
                                <span>Started</span><span>@Fmt.Date(l.StartDate)</span>
                                @if (l.ExtraMonthlyPayment > 0) { <span>Extra / month</span><span class="num">@Fmt.Money(l.ExtraMonthlyPayment)</span> }
                                <span>Secured against</span><span>@(AssetName(l) ?? "nothing")</span>
                            </span>
                            @if (!string.IsNullOrWhiteSpace(l.Notes)) { <span class="tip-note">@l.Notes</span> }
                        </span>
                    </span>
                </td>
                <td>@Fmt.Words(l.Kind)</td>
                <td class="muted">@(AssetName(l) ?? "—")</td>
                <td class="money">@l.AnnualRatePercent.ToString("0.###")%</td>
                <td class="money">@Fmt.Money(l.ScheduledPayment)</td>
                <td class="money">@Fmt.Money(l.LatestBalance)</td>
                <td class="muted">@Fmt.Date(l.LatestBalanceAsOf)</td>
                <td class="center">@if (l.IsActive) { <span class="tick">✓</span> } else { <span class="muted">—</span> }</td>
                <td class="actions icons">
                    <button class="link" type="button" title="Payoff projection" @onclick="() => Project(l)">☰</button>
                    <button class="link" type="button" title="Record a balance" @onclick="() => OpenBalance(l)">＋</button>
                    <button class="link" type="button" title="Edit loan" @onclick="() => Edit(l)">✎</button>
                </td>
            </tr>
        }
        </tbody>
        <tfoot>
            <tr>
                <th colspan="4">Owed</th>
                <th class="money"><Money Value="loans.Where(l => l.IsActive).Sum(l => l.ScheduledPayment ?? 0)" /></th>
                <th class="money"><Money Value="loans.Where(l => l.IsActive).Sum(l => l.LatestBalance ?? 0)" /></th>
                <th colspan="3"></th>
            </tr>
        </tfoot>
    </table>

    @if (balanceFor is { } bl)
    {
        <section class="panel">
            <h3>Record balance · @bl.Name</h3>
            <div class="row">
                <div class="field"><label>As of</label><input type="date" @bind="newBalance.AsOf" /></div>
                <div class="field"><label>Balance</label><input type="number" step="0.01" @bind="newBalance.Balance" /></div>
                <div class="field"><label>&nbsp;</label><button type="button" @onclick="SaveBalance">Save</button> <button class="secondary" type="button" @onclick="() => balanceFor = null">Close</button></div>
            </div>
        </section>
    }

    @if (editing is not null)
    {
        @* Over the page, not appended below a long table where it opens out of view. *@
        <Modal Title="@(editing.Id == 0 ? "New loan" : editing.Name)" OnClose="() => editing = null">
            <ChildContent>
            <EditForm Model="editing" OnValidSubmit="Save" class="form" id="loans-form">
                <DataAnnotationsValidator />
                <fieldset class="group">
                    <legend>Loan</legend>
                    <div class="field"><label>Name</label><InputText @bind-Value="editing.Name" /><ValidationMessage For="() => editing.Name" /></div>
                    <div class="field"><label>Kind</label><InputSelect @bind-Value="editing.Kind">@foreach (var k in Enum.GetValues<LoanKind>()) { <option value="@k">@Fmt.Words(k)</option> }</InputSelect></div>
                    <div class="field"><label>Lender</label><InputText @bind-Value="editing.Lender" /></div>
                    <div class="field"><label>Loan / account #</label><InputText @bind-Value="editing.AccountNumber" /></div>
                </fieldset>
                <fieldset class="group">
                    <legend>Terms</legend>
                    <div class="field"><label>Original principal</label><InputNumber @bind-Value="editing.OriginalPrincipal" step="0.01" /></div>
                    <div class="field"><label>Rate %</label><InputNumber @bind-Value="editing.AnnualRatePercent" step="0.001" /></div>
                    <div class="field"><label>Term (months)</label><InputNumber @bind-Value="editing.TermMonths" /></div>
                    <div class="field"><label>First payment</label><InputDate @bind-Value="editing.StartDate" /></div>
                    <div class="field"><label>Scheduled payment <span class="muted">(blank = compute)</span></label><InputNumber @bind-Value="editing.ScheduledPayment" step="0.01" /></div>
                    <div class="field"><label>Extra principal / month</label><InputNumber @bind-Value="editing.ExtraMonthlyPayment" step="0.01" /></div>
                </fieldset>
                <fieldset class="group">
                    <legend>In the ledger</legend>
                    <div class="field"><label>Budget line that carries the payment</label><InputSelect @bind-Value="editing.BudgetLineId"><option value="">—</option>@foreach (var b in lines) { <option value="@b.Id">@b.Name</option> }</InputSelect></div>
                    <div class="field"><label>Secured against <span class="muted">(the asset this loan is borrowed on)</span></label><InputSelect @bind-Value="editing.AssetId"><option value="">— nothing</option>@foreach (var a in assets.Where(a => a.IsActive)) { <option value="@a.Id">@a.Name</option> }</InputSelect></div>
                    <div class="checks"><label class="inline"><InputCheckbox @bind-Value="editing.IsActive" /> Active</label></div>
                </fieldset>
                <div class="field full"><label>Notes</label><InputTextArea @bind-Value="editing.Notes" rows="2" /></div>
            </EditForm>
            </ChildContent>
            <Footer>
                @if (editing.Id != 0) { <button class="link danger" type="button" @onclick="DeleteEditing">Delete loan</button> }
                <button type="submit" form="loans-form">Save</button>
                <button class="secondary" type="button" @onclick="() => editing = null">Cancel</button>
            </Footer>
        </Modal>
    }

    @if (projection is { } p)
    {
        <section class="panel">
            <h2>@p.Name · projection from @Fmt.Money(p.FromBalance) (@p.FromSource)</h2>
            <div class="row">
                <div class="field"><label>Extra principal / month</label><input type="number" step="0.01" @bind="extraTry" /></div>
                <div class="field"><label>&nbsp;</label><button type="button" @onclick="() => Project(loans.First(l => l.Id == p.LoanId), extraTry)">Recalculate</button></div>
            </div>
            <table class="estimate">
                <tbody>
                    <tr title="@p.PaymentFormula"><td>Scheduled payment</td><td class="money"><Money Value="p.ScheduledPayment" /></td></tr>
                    <tr><td>Payoff</td><td class="money">@Fmt.Date(p.PayoffDate) <span class="muted">(@p.MonthsRemaining payments)</span></td></tr>
                    <tr><td>Interest remaining</td><td class="money"><Money Value="p.InterestRemaining" /></td></tr>
                    <tr><td>Total remaining</td><td class="money"><Money Value="p.TotalRemaining" /></td></tr>
                    @if (p.InterestSavedByExtra is { } saved) { <tr class="sub"><td>Extra @Fmt.Money(p.ExtraMonthly)/mo saves</td><td class="money"><Money Value="saved" /> <span class="muted">and @p.MonthsSavedByExtra months</span></td></tr> }
                    @if (p.ScheduledBalanceNow is { } sb) { <tr><td>Original schedule says balance now (after @p.PaymentsMadeOnSchedule payments)</td><td class="money"><Money Value="sb" /> <span class="muted">vs @Fmt.Money(p.FromBalance) actual</span></td></tr> }
                </tbody>
            </table>
            <details>
                <summary>Schedule (@p.Rows.Count rows)</summary>
                <div class="scroll-x">
                <table>
                    <thead><tr><th>#</th><th>Date</th><th class="money">Payment</th><th class="money">Interest</th><th class="money">Principal</th><th class="money">Extra</th><th class="money">Balance</th></tr></thead>
                    <tbody>
                    @foreach (var r in p.Rows)
                    {
                        <tr><td>@r.Number</td><td>@Fmt.Date(r.Date)</td><td><Money Value="r.Payment" /></td><td><Money Value="r.Interest" /></td><td><Money Value="r.Principal" /></td><td><Money Value="r.Extra" /></td><td><Money Value="r.Balance" /></td></tr>
                    }
                    </tbody>
                </table>
                </div>
            </details>
        </section>
    }
}

@code {
    private List<LoanDto>? loans;
    private List<BudgetLineDto>? lines;
    private List<AssetDto>? assets;
    private bool showInactive;

    private string? AssetName(LoanDto l) => l.AssetId is { } id ? assets!.FirstOrDefault(a => a.Id == id)?.Name : null;
    private LoanDto? editing;
    private LoanDto? balanceFor;
    private LoanBalanceDto newBalance = new();
    private LoanProjectionDto? projection;
    private decimal extraTry;
    private string? error;

    protected override Task OnInitializedAsync() => Load();

    private async Task Load()
    {
        try { loans = await Api.GetLoansAsync(); lines = await Api.GetBudgetLinesAsync(); assets = await Api.GetAssetsAsync(); }
        catch (Exception ex) { error = ex.Message; }
    }

    private void Edit(LoanDto l)
    {
        projection = null; balanceFor = null;
        editing = new()
        {
            Id = l.Id, Name = l.Name, Kind = l.Kind, Lender = l.Lender, AccountNumber = l.AccountNumber, OriginalPrincipal = l.OriginalPrincipal, AnnualRatePercent = l.AnnualRatePercent, TermMonths = l.TermMonths,
            StartDate = l.StartDate, ScheduledPayment = l.ScheduledPayment, ExtraMonthlyPayment = l.ExtraMonthlyPayment, BudgetLineId = l.BudgetLineId, AssetId = l.AssetId, Notes = l.Notes, IsActive = l.IsActive,
        };
    }

    private async Task Save()
    {
        try { await Api.SaveLoanAsync(editing!); editing = null; await Load(); }
        catch (Exception ex) { error = ex.Message; }
    }

    private async Task DeleteEditing()
    {
        try { await Api.DeleteLoanAsync(editing!.Id); editing = null; await Load(); }
        catch (Exception ex) { error = ex.Message; }
    }

    private void OpenBalance(LoanDto l) { editing = null; balanceFor = l; newBalance = new() { LoanId = l.Id, AsOf = DateOnly.FromDateTime(DateTime.Today), Balance = l.LatestBalance ?? 0 }; }

    private async Task SaveBalance()
    {
        try { await Api.SaveLoanBalanceAsync(balanceFor!.Id, newBalance); balanceFor = null; await Load(); }
        catch (Exception ex) { error = ex.Message; }
    }

    private async Task Project(LoanDto l, decimal? extra = null)
    {
        editing = null; balanceFor = null;
        try { projection = await Api.GetLoanProjectionAsync(l.Id, extra); extraTry = projection.ExtraMonthly; }
        catch (Exception ex) { error = ex.Message; }
    }
}
