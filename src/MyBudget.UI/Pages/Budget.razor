@page "/budget"
@page "/bills"
@inject ApiClient Api
@using MyBudget.Domain

<ErrorBanner @bind-Message="error" />

@if (lines is null || accounts is null || cards is null || categories is null || labels is null || history is null)
{
    <p class="muted">Loading…</p>
}
else
{
    <div class="toolbar">
        <button type="button" @onclick="() => Edit(new BudgetLineDto())">New budget line</button>
        <span class="year-nav">
            <button class="secondary" type="button" title="Previous year" @onclick="() => ChangeYear(year - 1)">‹</button>
            <strong>@year</strong>
            <button class="secondary" type="button" title="Next year" @onclick="() => ChangeYear(year + 1)">›</button>
        </span>
        <label class="inline">Sort
            <select @bind="sort">
                <option value="due">by due day</option>
                <option value="name">by name</option>
                <option value="category">by category, then name</option>
            </select>
        </label>
        <details class="dropdown">
            <summary class="btn secondary">Columns ▾</summary>
            <div class="dropdown-menu">
                @foreach (var c in OptionalColumns)
                {
                    <label class="inline"><input type="checkbox" checked="@shown.Contains(c)" @onchange="e => Toggle(c, e)" /> @c</label>
                }
            </div>
        </details>
        <details class="dropdown">
            <summary class="btn secondary">@(categoryFilter is { } cf ? "Category: " + categories.FirstOrDefault(c => c.Id == cf)?.Name : "Category ▾")</summary>
            <div class="dropdown-menu">
                <label class="inline"><input type="radio" name="catf" checked="@(categoryFilter is null)" @onchange="() => categoryFilter = null" /> All</label>
                @foreach (var c in categories.Where(c => c.IsActive).OrderBy(c => c.Name))
                {
                    var cat = c;
                    <label class="inline"><input type="radio" name="catf" checked="@(categoryFilter == cat.Id)" @onchange="() => categoryFilter = cat.Id" /> @cat.Name <span class="muted">@lines.Count(b => b.CategoryId == cat.Id)</span></label>
                }
                <a class="muted" href="categories">Manage categories and labels…</a>
            </div>
        </details>
        <label class="inline"><input type="checkbox" @bind="showInactive" /> Show inactive</label>
    </div>

    @if (monthEdit is not null)
    {
        <section class="panel month-editor">
            <div class="month-head">
                <h3>@monthEdit.LineName · @monthEdit.Period.ToString("MMMM yyyy")</h3>
                <span class="muted">Usually @Fmt.Money(monthEdit.DefaultProjected)@(monthEdit.DefaultDueDate is { } dd ? $", due {Fmt.Date(dd)}" : ", not due this month")</span>
            </div>
            <div class="month-body">
                <fieldset class="group primary">
                    <legend>What actually happened</legend>
                    <div class="field"><label>Amount paid</label>
                        <input type="number" step="0.01" @bind="monthEdit.ActualAmount" @bind:event="oninput" @onkeydown="OnMonthKey" @ref="actualInput" placeholder="0.00" /></div>
                    <div class="field"><label>Paid on</label><OptionalDate Value="monthEdit.PaidOn" ValueChanged="SetPaidOn" Suggested="Today" Empty="not paid yet" @onkeydown="OnMonthKey" />
                        @if (monthEdit.PaidOnIsSuggested && monthEdit.ActualAmount is null) { <span class="hint">saved once an amount is entered</span> }</div>
                    <div class="field"><label>Confirmation #</label>
                        <input type="text" maxlength="60" @bind="monthEdit.ConfirmationNumber" @bind:event="oninput" @onkeydown="OnMonthKey" placeholder="if the biller gave one" /></div>
                </fieldset>
                <fieldset class="group">
                    <legend>Only if this month is different</legend>
                    <div class="field"><label>Expected amount</label>
                        <input type="number" step="0.01" @bind="monthEdit.ProjectedAmount" @bind:event="oninput" @onkeydown="OnMonthKey" placeholder="@monthEdit.DefaultProjected.ToString("0.00")" /></div>
                    <div class="field"><label>Due date</label><OptionalDate @bind-Value="monthEdit.DueDate" Suggested="monthEdit.DefaultDueDate ?? monthEdit.Period" Empty="use the usual" @onkeydown="OnMonthKey" /></div>
                </fieldset>
                <div class="field notes"><label>Notes</label><input type="text" @bind="monthEdit.Notes" @bind:event="oninput" @onkeydown="OnMonthKey" placeholder="e.g. paid late, split payment" /></div>
            </div>
            <div class="actions-row">
                <span class="muted push-left">Enter saves · Esc closes · blank means "use the usual"</span>
                <button class="link danger" type="button" @onclick="ClearMonth">Clear this month</button>
                <button type="button" @onclick="SaveMonth">Save</button>
                <button class="secondary" type="button" @onclick="() => monthEdit = null">Close</button>
            </div>
        </section>
    }

    <div class="scroll-x">
    <table class="grid">
        <thead>
            <tr>
                <th>Budget line</th>
                @if (Show("Category")) { <th>Category</th> }
                @if (Show("Due")) { <th>Due</th> }
                @if (Show("Paid via")) { <th>Paid via</th> }
                @if (Show("Funded from")) { <th>Funded from</th> }
                @if (Show("Projected")) { <th class="money">Proj.</th> }
                @for (var m = 1; m <= 12; m++) { <th class="month-head @(IsNow(m) ? "now now-top" : "")">@Fmt.Month(new DateOnly(year, m, 1))</th> }
                @if (Show("Avg actual")) { <th class="money">Avg</th> }
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var b in Sorted(lines.Where(b => (showInactive || b.IsActive) && (categoryFilter is null || b.CategoryId == categoryFilter))))
        {
            var h = history.FirstOrDefault(x => x.BudgetLineId == b.Id);
            <tr class="@(b.IsActive ? "" : "muted")">
                <td>
                    @* A line covers several labels — General Merchandise is Amazon, Costco and the
                       rest — so it opens to show where the money actually went. No category row:
                       a line has exactly one category. *@
                    <button class="link tree" type="button" title="Where this line's money went, by label" @onclick="() => ToggleLabels(b.Id)">
                        <span class="caret">@(labelsOpen == b.Id ? "▾" : "▸")</span>
                    </button>
                    <span class="tip">@b.Name
                        <span class="tip-box">
                            <span class="tip-head">
                                <b>@b.Name</b>
                                <span class="chip small">@(categories.FirstOrDefault(c => c.Id == b.CategoryId)?.Name ?? "Uncategorized")</span>
                            </span>
                            <span class="tip-grid">
                                <span>Schedule</span><span>@DueText(b)</span>
                                <span>Amount</span><span class="num">@Fmt.Money(b.ProjectedAmount)@(b.Frequency == BudgetFrequency.Variable ? " / mo planned" : "")</span>
                                <span>Paid via</span><span>@PaidVia(b)@(b.IsAutopay ? ", autopay" : ", by hand")</span>
                                <span>Funded from</span><span>@(accounts.FirstOrDefault(a => a.Id == b.FundingAccountId)?.Name ?? "—")</span>
                                @if (!string.IsNullOrWhiteSpace(b.AccountNumber)) { <span>Account #</span><span>@b.AccountNumber</span> }
                                @if (b.BankAutopayDiscount is { } d) { <span>Bank discount</span><span class="num">@Fmt.Money(d) / mo</span> }
                                @if (b.EndDate is { } end) { <span>Ends</span><span>@Fmt.Date(end)</span> }
                            </span>
                            @if (PriorYear(b.Id) is { } py)
                            {
                                <span class="tip-hist">
                                    <span class="h"></span><span class="h num">Total</span><span class="h num">Months</span><span class="h num">Avg</span>
                                    <span>@(year - 1)</span><span class="num">@Fmt.Money(py.Total)</span><span class="num">@py.Months</span><span class="num">@Fmt.Money(py.Average)</span>
                                    @if (ThisYearSoFar(b.Id) is { } ty)
                                    {
                                        <span>@year</span><span class="num">@Fmt.Money(ty.Total)</span><span class="num">@ty.Months</span><span class="num">@Fmt.Money(ty.Average)</span>
                                        <span class="h">Change</span><span class="h num wide @(ty.Average > py.Average ? "neg" : ty.Average < py.Average ? "pos" : "")">@Delta(py.Average, ty.Average) / mo</span>
                                    }
                                </span>
                            }
                            @if (!string.IsNullOrWhiteSpace(b.Notes)) { <span class="tip-note">@b.Notes</span> }
                        </span>
                    </span>
                </td>
                @if (Show("Category")) { <td>@(categories.FirstOrDefault(c => c.Id == b.CategoryId)?.Name)</td> }
                @if (Show("Due")) { <td>@(DueDayOf(b) is { } day ? Ordinal(day) : "")</td> }
                @if (Show("Paid via")) { <td>@PaidVia(b)</td> }
                @if (Show("Funded from")) { <td>@accounts.FirstOrDefault(a => a.Id == b.FundingAccountId)?.Name</td> }
                @if (Show("Projected")) { <td><Money Value="b.ProjectedAmount" /></td> }
                @if (h is not null)
                {
                    @foreach (var mo in h.Months)
                    {
                        var isEditing = monthEdit is { } e && e.BudgetLineId == b.Id && e.Period == mo.Period;
                        <td class="cell @(mo.Projected == 0 && mo.Actual is null ? "dim" : "") @(mo.Variance > 0 ? "over" : "") @(isEditing ? "editing" : "") @(IsNow(mo.Period.Month) ? "now" : "")"
                            @onclick="() => OpenMonth(b, mo)" title="@Title(mo, PriorMonth(b.Id, mo.Period.Month))">
                            @if (mo.Actual is { } a)
                            {
                                <Money Value="a" />
                            }
                            else if (mo.Projected != 0)
                            {
                                <span class="muted money">(@Fmt.Money(mo.Projected))</span>
                            }
                            @if (mo.ProjectedIsOverride || mo.DueDateIsOverride) { <sup class="ovr" title="has a per-month override">•</sup> }
                        </td>
                    }
                    @if (Show("Avg actual")) { <td class="money">@Fmt.Money(h.AverageActual)</td> }
                }
                else
                {
                    <td colspan="@(12 + (Show("Avg actual") ? 1 : 0))"></td>
                }
                <td><button class="link" type="button" title="Edit line" @onclick="() => Edit(b)">✎</button></td>
            </tr>

            @if (labelsOpen == b.Id)
            {
                @if (labelRows is null)
                {
                    <tr class="label-row"><td colspan="99" class="muted">Loading…</td></tr>
                }
                else if (labelRows.Rows.Count == 0)
                {
                    <tr class="label-row"><td colspan="99" class="muted">No transactions on this line in @year yet.</td></tr>
                }
                else
                {
                    @foreach (var lr in labelRows.Rows)
                    {
                        <tr class="label-row" @key="lr.LabelId">
                            <td class="indent muted">@lr.LabelName</td>
                            @if (Show("Category")) { <td></td> }
                            @if (Show("Due")) { <td></td> }
                            @if (Show("Paid via")) { <td></td> }
                            @if (Show("Funded from")) { <td></td> }
                            @if (Show("Projected")) { <td></td> }
                            @foreach (var m in lr.Months)
                            {
                                <td class="money muted">@(m == 0 ? "" : Fmt.Money(m))</td>
                            }
                            @if (Show("Avg actual")) { <td class="money muted">@Fmt.Money(lr.Total)</td> }
                            <td></td>
                        </tr>
                    }
                }
            }
        }
        </tbody>
        <tfoot>
            <tr>
                <th colspan="@(1 + shown.Count(c => c != "Avg actual"))">Projected</th>
                @for (var m = 1; m <= 12; m++)
                {
                    var period = new DateOnly(year, m, 1);
                    <th class="money @(IsNow(m) ? "now" : "")"><Money Value="MonthSum(period, x => x.Projected)" /></th>
                }
                <th colspan="@(Show("Avg actual") ? 2 : 1)"></th>
            </tr>
            <tr>
                <th colspan="@(1 + shown.Count(c => c != "Avg actual"))">Actual</th>
                @for (var m = 1; m <= 12; m++)
                {
                    var period = new DateOnly(year, m, 1);
                    <th class="money @(IsNow(m) ? "now now-bottom" : "")"><Money Value="MonthSum(period, x => x.Actual ?? 0m)" /></th>
                }
                <th colspan="@(Show("Avg actual") ? 2 : 1)"></th>
            </tr>
        </tfoot>
    </table>
    </div>

    @if (editing is not null)
    {
        @* Over the page, not appended below a long table where it opens out of view. *@
        <Modal Title="@(editing.Id == 0 ? "New line" : editing.Name)" OnClose="() => editing = null">
            <ChildContent>
            <EditForm Model="editing" OnValidSubmit="Save" class="form" id="budget-form">
                <DataAnnotationsValidator />
                <fieldset class="group">
                    <legend>Budget line</legend>
                    <div class="field"><label>Name</label><InputText @bind-Value="editing.Name" /><ValidationMessage For="() => editing.Name" /></div>
                    <div class="field"><label>Category</label><InputSelect @bind-Value="editing.CategoryId">
                        <option value="">—</option>
                        @foreach (var c in categories.Where(c => c.IsActive)) { <option value="@c.Id">@c.Name</option> }
                    </InputSelect></div>
                    <div class="field"><label>Label <span class="muted">(optional; budgets one merchant apart from its category)</span></label><InputSelect @bind-Value="editing.LabelId">
                        <option value="">—</option>
                        @foreach (var l in LabelChoices.For(labels, editing.CategoryId, editing.LabelId)) { <option @key="l.Id" value="@l.Id">@l.Name</option> }
                    </InputSelect></div>
                    <div class="field"><label>Account / member #</label><InputText @bind-Value="editing.AccountNumber" /></div>
                </fieldset>
                <fieldset class="group">
                    <legend>Amount and timing</legend>
                    <div class="field"><label>@(editing.Frequency == BudgetFrequency.Variable ? "Planned per month" : "Usual amount")</label><InputNumber @bind-Value="editing.ProjectedAmount" step="0.01" /></div>
                    <div class="field"><label>Frequency</label><InputSelect @bind-Value="editing.Frequency">
                        @foreach (var f in Enum.GetValues<BudgetFrequency>()) { <option value="@f">@Fmt.Words(f)</option> }
                    </InputSelect></div>
                    @if (editing.Frequency == BudgetFrequency.Variable)
                    {
                        <p class="muted">Planned spend with no due date and no biller. The amount is what you expect to spend in a month.</p>
                    }
                    else
                    {
                        <div class="field"><label>Due day (31 = last)</label><InputNumber @bind-Value="editing.DueDay" /></div>
                        @if (editing.Frequency != BudgetFrequency.Monthly)
                        {
                            <div class="field"><label>@(editing.Frequency == BudgetFrequency.OneOff ? "Due date" : "A known due date")</label><InputDate @bind-Value="editing.AnchorDueDate" /></div>
                        }
                    }
                    <div class="field"><label>Starts</label><OptionalDate @bind-Value="editing.StartDate" Empty="from the beginning" /></div>
                    <div class="field"><label>Ends <span class="muted">(last month owed)</span></label><OptionalDate @bind-Value="editing.EndDate" Empty="no end" /></div>
                    <div class="field full">
                        @* One amount would restate every month already budgeted at the old price. Rows
                           here say what it cost from a month onward; a single odd month is still an
                           override on the grid. *@
                        <label>Amount changes</label>
                        @* One row per change — from, amount, why — rather than each input on its own line. *@
                        @foreach (var a in editing.Amounts.OrderBy(a => a.FromPeriod))
                        {
                            <div class="amount-change" @key="a">
                                <input type="month" title="First month at this amount" value="@a.FromPeriod.ToString("yyyy-MM")" @onchange="e => SetAmountMonth(a, e)" />
                                <InputNumber @bind-Value="a.Amount" step="0.01" title="Amount from that month" />
                                <InputText @bind-Value="a.Notes" placeholder="why, e.g. membership went up" />
                                <button class="link danger" type="button" title="Remove this change" @onclick="() => editing.Amounts.Remove(a)">✕</button>
                            </div>
                        }
                        <button class="secondary" type="button" @onclick="AddAmountChange">Add an amount change</button>
                        <span class="hint">The usual amount applies until the first change; each change applies from its month until the next.</span>
                    </div>
                </fieldset>
                <fieldset class="group">
                    <legend>How it's paid</legend>
                    <div class="field"><label>Paid via</label><InputSelect @bind-Value="editing.PaymentMethod">
                        <option value="@PaymentMethodKind.Account">Bank account</option>
                        <option value="@PaymentMethodKind.Card">Credit card</option>
                        <option value="@PaymentMethodKind.Cash">Cash</option>
                    </InputSelect></div>
                    @if (editing.PaymentMethod == PaymentMethodKind.Account)
                    {
                        <div class="field"><label>Paying account</label><InputSelect @bind-Value="editing.PaymentAccountId">
                            <option value="">—</option>
                            @foreach (var a in accounts.Where(a => a.IsActive)) { <option value="@a.Id">@Fmt.Label(a.Name, a.AccountNumber)</option> }
                        </InputSelect></div>
                    }
                    else if (editing.PaymentMethod == PaymentMethodKind.Card)
                    {
                        <div class="field"><label>Paying card</label><InputSelect @bind-Value="editing.PaymentCardId">
                            <option value="">—</option>
                            @foreach (var c in cards.Where(c => c.IsActive)) { <option value="@c.Id">@Fmt.Label(c.Display, c.AccountNumber)</option> }
                        </InputSelect></div>
                    }
                    else
                    {
                        @* Cash names no payer. "Funded from" below still says which account it comes out of. *@
                        <div class="field"><label>Paying account</label><span class="muted">Cash — nothing to pick</span></div>
                    }
                    <div class="field"><label>Funded from <span class="muted">(where the money really comes from)</span></label><InputSelect @bind-Value="editing.FundingAccountId">
                        <option value="0">—</option>
                        @foreach (var a in accounts.Where(a => a.IsActive)) { <option value="@a.Id">@Fmt.Label(a.Name, a.AccountNumber)</option> }
                    </InputSelect><ValidationMessage For="() => editing.FundingAccountId" /></div>
                    <div class="field"><label>Bank-autopay discount / month</label><InputNumber @bind-Value="editing.BankAutopayDiscount" step="0.01" /></div>
                    <div class="checks">
                        <label class="inline"><InputCheckbox @bind-Value="editing.IsAutopay" /> Autopay</label>
                        <label class="inline"><InputCheckbox @bind-Value="editing.IsCardEligible" /> Can go on a card</label>
                        <label class="inline"><InputCheckbox @bind-Value="editing.IsActive" /> Active</label>
                    </div>
                </fieldset>
                <div class="field full"><label>Notes</label><InputTextArea @bind-Value="editing.Notes" rows="2" /></div>
            </EditForm>
            </ChildContent>
            <Footer>
                @if (editing.Id != 0) { <button class="link danger" type="button" @onclick="DeleteEditing">Delete line</button> }
                <button type="submit" form="budget-form">Save</button>
                <button class="secondary" type="button" @onclick="() => editing = null">Cancel</button>
            </Footer>
        </Modal>
    }

}

@code {
    private static readonly string[] OptionalColumns = ["Projected", "Category", "Due", "Paid via", "Funded from", "Avg actual"];

    private List<BudgetLineDto>? lines;
    private List<AccountDto>? accounts;
    private List<CardDto>? cards;
    private List<CategoryDto>? categories;
    private List<LabelDto>? labels;
    private List<BudgetHistoryDto>? history;
    /// <summary>Last year's grid, for the "what did this cost me last year" comparison in the hovers.</summary>
    private List<BudgetHistoryDto>? priorHistory;
    private int year = DateTime.Today.Year;
    private bool showInactive;
    private int? labelsOpen;
    private BudgetLabelBreakdownDto? labelRows;

    /// <summary>
    /// Opens a line to show where its money went by label. Fetched on demand rather than with the
    /// grid — a breakdown for every line would be a query per line for something rarely looked at.
    /// </summary>
    private async Task ToggleLabels(int lineId)
    {
        if (labelsOpen == lineId) { labelsOpen = null; labelRows = null; return; }

        labelsOpen = lineId;
        labelRows = null;
        try { labelRows = await Api.GetBudgetLabelsAsync(lineId, year); }
        catch (Exception ex) { error = ex.Message; labelsOpen = null; }
    }


    /// <summary>Starts a new amount row at this month, or the month after the last change.</summary>
    private void AddAmountChange()
    {
        if (editing is not { } e) return;
        var today = DateOnly.FromDateTime(DateTime.Today);
        var from = e.Amounts.Count > 0 ? e.Amounts.Max(a => a.FromPeriod).AddMonths(1) : new DateOnly(today.Year, today.Month, 1);
        e.Amounts.Add(new BudgetLineAmountDto { FromPeriod = from, Amount = e.ProjectedAmount });
    }

    private void SetAmountMonth(BudgetLineAmountDto row, ChangeEventArgs e)
    {
        if (DateOnly.TryParse($"{e.Value}-01", out var month)) row.FromPeriod = month;
    }
    private string sort = "due";   // the order bills come out of the account

    /// <summary>
    /// Name, category then name, or the day of the month a line falls due — the order bills come out
    /// of the account. Uncategorised and undated (Variable) lines sort last rather than first, and the
    /// name is always the tie-break so the order is stable.
    /// </summary>
    private IEnumerable<BudgetLineDto> Sorted(IEnumerable<BudgetLineDto> rows) => sort switch
    {
        "category" => rows
            .OrderBy(b => b.CategoryId is null)
            .ThenBy(b => CategoryName(b.CategoryId), StringComparer.OrdinalIgnoreCase)
            .ThenBy(b => b.Name, StringComparer.OrdinalIgnoreCase),
        "due" => rows
            .OrderBy(b => DueDayOf(b) is null)
            .ThenBy(DueDayOf)
            .ThenBy(b => b.Name, StringComparer.OrdinalIgnoreCase),
        _ => rows.OrderBy(b => b.Name, StringComparer.OrdinalIgnoreCase),
    };

    /// <summary>
    /// The day of the month a payment is due, as <c>BudgetDueDates</c> generates it: the line's due day
    /// for monthly and periodic lines (the anchor date only picks the month), the anchor's own day for a
    /// one-off, and none for a Variable line, which is planned spend rather than a bill.
    /// </summary>
    private static int? DueDayOf(BudgetLineDto b) => b.Frequency switch
    {
        BudgetFrequency.Variable => null,
        BudgetFrequency.OneOff => b.AnchorDueDate?.Day,
        _ => b.DueDay,
    };

    private string CategoryName(int? id) => categories?.FirstOrDefault(c => c.Id == id)?.Name ?? "";
    private readonly HashSet<string> shown = [];
    private BudgetLineDto? editing;
    private int? categoryFilter;
    private MonthEdit? monthEdit;
    private ElementReference actualInput;
    private string? error;

    private sealed class MonthEdit
    {
        public int BudgetLineId; public string LineName = ""; public DateOnly Period;
        public decimal DefaultProjected; public DateOnly? DefaultDueDate;
        public decimal? ActualAmount; public decimal? ProjectedAmount; public DateOnly? DueDate; public DateOnly? PaidOn; public string? ConfirmationNumber; public string? Notes;
        /// <summary>Paid on holds today because the editor filled it in, not because it was chosen.</summary>
        public bool PaidOnIsSuggested;
    }

    private static DateOnly Today => DateOnly.FromDateTime(DateTime.Today);

    private void SetPaidOn(DateOnly? d) { monthEdit!.PaidOn = d; monthEdit.PaidOnIsSuggested = false; }

    protected override Task OnInitializedAsync() => Load();

    private async Task Load()
    {
        try
        {
            lines = await Api.GetBudgetLinesAsync();
            accounts = await Api.GetAccountsAsync();
            cards = await Api.GetCardsAsync();
            categories = await Api.GetCategoriesAsync();
            labels = await Api.GetLabelsAsync();
            history = await Api.GetBudgetHistoryAsync(year);
            priorHistory = await Api.GetBudgetHistoryAsync(year - 1);
        }
        catch (Exception ex) { error = ex.Message; }
    }

    private async Task ChangeYear(int y) { year = y; monthEdit = null; await Load(); }

    private bool Show(string col) => shown.Contains(col);
    private bool IsNow(int month) => year == DateTime.Today.Year && month == DateTime.Today.Month;
    private void Toggle(string col, ChangeEventArgs e) { if (e.Value is true) shown.Add(col); else shown.Remove(col); }

    private decimal MonthSum(DateOnly period, Func<BudgetMonthDto, decimal> pick)
        => history!.Where(h => lines!.Any(b => b.Id == h.BudgetLineId && (showInactive || b.IsActive) && (categoryFilter is null || b.CategoryId == categoryFilter)))
                   .SelectMany(h => h.Months).Where(m => m.Period == period).Sum(pick);

    private string DueText(BudgetLineDto b) => b.Frequency switch
    {
        BudgetFrequency.Monthly => $"{Ordinal(b.DueDay)} of the month",
        BudgetFrequency.OneOff => Fmt.Date(b.AnchorDueDate),
        _ => $"{Fmt.Words(b.Frequency)} from {Fmt.Date(b.AnchorDueDate)}",
    };

    private static string Ordinal(int d) => d == 31 ? "last day" : d + (d % 100 is 11 or 12 or 13 ? "th" : (d % 10) switch { 1 => "st", 2 => "nd", 3 => "rd", _ => "th" });

    private string PaidVia(BudgetLineDto b) => b.PaymentMethod == PaymentMethodKind.Card
        ? "💳 " + cards!.FirstOrDefault(c => c.Id == b.PaymentCardId)?.Name
        : accounts!.FirstOrDefault(a => a.Id == b.PaymentAccountId)?.Name ?? "—";

    /// <summary>Native tooltips take no markup, so structure comes from one labelled fact per line.</summary>
    private static string Title(BudgetMonthDto m, decimal? priorYearActual = null)
    {
        var lines = new List<string> { m.Period.ToString("MMMM yyyy") };
        if (m.DueDate is { } d) lines.Add($"Due          {Fmt.Date(d)}{(m.DueDateIsOverride ? "  (this month only)" : "")}");
        lines.Add($"Expected     {Fmt.Money(m.Projected)}{(m.ProjectedIsOverride ? "  (this month only)" : "")}");
        if (m.Actual is { } a)
        {
            lines.Add($"Actual       {Fmt.Money(a)}");
            if (m.Variance is { } v && v != 0) lines.Add($"             {(v > 0 ? "over by" : "under by")} {Fmt.Money(Math.Abs(v))}");
        }
        if (m.PaidOn is { } p) lines.Add($"Paid         {Fmt.Date(p)}");
        if (!string.IsNullOrWhiteSpace(m.ConfirmationNumber)) lines.Add($"Confirmation {m.ConfirmationNumber}");
        if (priorYearActual is { } prior) lines.Add($"{m.Period.Year - 1} actual  {Fmt.Money(prior)}");
        if (!string.IsNullOrWhiteSpace(m.Notes)) lines.Add($"\n{m.Notes}");
        return string.Join("\n", lines);
    }

    /// <summary>A signed change, for the year-on-year row.</summary>
    private static string Delta(decimal from, decimal to)
        => to == from ? "no change" : $"{(to > from ? "+" : "−")}{Fmt.Money(Math.Abs(to - from))}";

    /// <summary>What this line actually cost last year: total, the months it was actually charged, and the average of those.</summary>
    private (decimal Total, int Months, decimal Average)? PriorYear(int lineId)
        => Totals(priorHistory, lineId);

    private (decimal Total, int Months, decimal Average)? ThisYearSoFar(int lineId)
        => Totals(history, lineId);

    private static (decimal Total, int Months, decimal Average)? Totals(List<BudgetHistoryDto>? source, int lineId)
    {
        var months = source?.FirstOrDefault(x => x.BudgetLineId == lineId)?.Months.Where(m => m.Actual is not null).ToList();
        if (months is null || months.Count == 0) return null;
        var total = months.Sum(m => m.Actual!.Value);
        return (total, months.Count, Math.Round(total / months.Count, 2));
    }

    /// <summary>The same month a year earlier, if it was recorded.</summary>
    private decimal? PriorMonth(int lineId, int month)
        => priorHistory?.FirstOrDefault(x => x.BudgetLineId == lineId)?.Months.FirstOrDefault(m => m.Period.Month == month)?.Actual;

    private void Edit(BudgetLineDto b)
    {
        monthEdit = null;
        editing = new()
        {
            Id = b.Id, Name = b.Name, CategoryId = b.CategoryId, LabelId = b.LabelId, AccountNumber = b.AccountNumber, Frequency = b.Frequency, DueDay = b.DueDay == 0 ? 1 : b.DueDay, AnchorDueDate = b.AnchorDueDate,
            IsAutopay = b.IsAutopay, ProjectedAmount = b.ProjectedAmount, PaymentMethod = b.PaymentMethod, PaymentAccountId = b.PaymentAccountId,
            PaymentCardId = b.PaymentCardId, FundingAccountId = b.FundingAccountId, BankAutopayDiscount = b.BankAutopayDiscount, IsCardEligible = b.IsCardEligible,
            StartDate = b.StartDate, EndDate = b.EndDate, Notes = b.Notes, IsActive = b.IsActive,
            // Copied, not shared: Cancel must leave the table's rows as they were. Leaving these two
            // out showed a saved label as blank and sent no price history, so the next save erased both.
            Amounts = b.Amounts.Select(a => new BudgetLineAmountDto { Id = a.Id, FromPeriod = a.FromPeriod, Amount = a.Amount, Notes = a.Notes }).ToList(),
        };
    }

    private async Task Save()
    {
        try { await Api.SaveBudgetLineAsync(editing!); editing = null; await Load(); }
        catch (Exception ex) { error = ex.Message; }
    }

    private async Task DeleteEditing()
    {
        try { await Api.DeleteBudgetLineAsync(editing!.Id); editing = null; await Load(); }
        catch (Exception ex) { error = ex.Message; }
    }

    private async Task OpenMonth(BudgetLineDto b, BudgetMonthDto m)
    {
        editing = null;
        var defaultProjected = m.ProjectedIsOverride ? b.ProjectedAmount : m.Projected;
        monthEdit = new MonthEdit
        {
            BudgetLineId = b.Id, LineName = b.Name, Period = m.Period,
            DefaultProjected = defaultProjected, DefaultDueDate = m.DueDateIsOverride ? null : m.DueDate,
            ActualAmount = m.Actual, ProjectedAmount = m.ProjectedIsOverride ? m.Projected : null,
            DueDate = m.DueDateIsOverride ? m.DueDate : null, PaidOn = m.PaidOn, ConfirmationNumber = m.ConfirmationNumber, Notes = m.Notes,
        };
        // Opening an unpaid month usually means paying it now, so Paid on starts at today. A Variable
        // line (Fuel) adds up over the month and has no single payment day, so it is left empty.
        if (m.Actual is null && m.PaidOn is null && b.Frequency != MyBudget.Domain.BudgetFrequency.Variable)
        {
            monthEdit.PaidOn = Today;
            monthEdit.PaidOnIsSuggested = true;
        }
        await Task.Yield();
        try { await actualInput.FocusAsync(); } catch { }
    }

    private async Task OnMonthKey(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") monthEdit = null;
        else if (e.Key == "Enter") await SaveMonth();
    }

    private async Task SaveMonth()
    {
        if (monthEdit is null) return;
        try
        {
            await Api.SaveBudgetPeriodAsync(monthEdit.BudgetLineId, monthEdit.Period, new BudgetPeriodDto
            {
                BudgetLineId = monthEdit.BudgetLineId, Period = monthEdit.Period, ActualAmount = monthEdit.ActualAmount,
                ProjectedAmount = monthEdit.ProjectedAmount, DueDate = monthEdit.DueDate,
                // A filled-in date with no amount would mark the month paid at its usual amount just for
                // changing a note or next month's expected amount. It takes an amount to make it a payment.
                PaidOn = monthEdit.PaidOnIsSuggested && monthEdit.ActualAmount is null ? null : monthEdit.PaidOn, ConfirmationNumber = monthEdit.ConfirmationNumber, Notes = monthEdit.Notes,
            });
            monthEdit = null;
            history = await Api.GetBudgetHistoryAsync(year);
        }
        catch (Exception ex) { error = ex.Message; }
    }

    private async Task ClearMonth()
    {
        if (monthEdit is null) return;
        try
        {
            await Api.SaveBudgetPeriodAsync(monthEdit.BudgetLineId, monthEdit.Period, new BudgetPeriodDto { BudgetLineId = monthEdit.BudgetLineId, Period = monthEdit.Period });
            monthEdit = null;
            history = await Api.GetBudgetHistoryAsync(year);
        }
        catch (Exception ex) { error = ex.Message; }
    }
}
