@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Nav
@using Microsoft.AspNetCore.Components.Routing

<div class="shell">
    <nav class="sidebar">
        <div class="brand">MyBudget</div>
        @foreach (var grp in Sections)
        {
            var open = expanded.Contains(grp.Name);
            var name = grp.Name;
            <button type="button" class="nav-group @(open ? "open" : "")" aria-expanded="@open" @onclick="() => Toggle(name)">
                <span class="caret">@(open ? "▾" : "▸")</span>
                <span class="label">@grp.Name</span>
                @if (!open && grp.Items.Any(IsCurrent)) { <span class="here" title="The page you're on is in this section">●</span> }
            </button>
            @if (open)
            {
                foreach (var item in grp.Items)
                {
                    <NavLink href="@item.Href" Match="@(item.Exact ? NavLinkMatch.All : NavLinkMatch.Prefix)">@item.Label</NavLink>
                }
            }
        }
    </nav>
    <main class="content" tabindex="-1">
        @Body
    </main>
</div>

@code {
    private sealed record NavItem(string Href, string Label, bool Exact = false);
    private sealed record NavSection(string Name, NavItem[] Items);

    /// <summary>The nav as data. "Budget" heads the group that previously had no header at all.</summary>
    private static readonly NavSection[] Sections =
    [
        new("Budget", [
            new("", "Dashboard", Exact: true),
            new("budget", "Budget"),
            new("cards", "Cards"),
            new("paycheck", "Paycheck"),
            new("hsa", "HSA"),
            new("rewards", "Rewards status"),
        ]),
        new("Wealth", [new("investments", "Investments"), new("assets", "Assets"), new("owed", "Owed to me")]),
        new("Calculators", [new("paycheck-what-if", "Paycheck what-if"), new("points-vs-cash", "Points vs cash")]),
        new("History", [new("transactions", "Transactions"), new("reports", "Reports")]),
        new("Assistant", [new("assistant", "Chat")]),
        new("Admin", [
            new("accounts", "Accounts"),
            new("income", "Income sources"),
            new("loans", "Loans"),
            new("categories", "Categories & labels"),
            new("loyalty-programs", "Loyalty programs"),
            new("goals", "Goals"),
            new("import", "Import"),
            new("tax-tables", "Tax tables"),
        ]),
    ];

    /// <summary>Everything starts collapsed but Budget; the rest opens as you go looking.</summary>
    private readonly HashSet<string> expanded = ["Budget"];

    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
        OpenSectionForCurrentPage();
    }

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        OpenSectionForCurrentPage();
        StateHasChanged();
    }

    /// <summary>
    /// A collapsed section hides the highlight that says where you are, so the section holding the
    /// current page is opened. Sections opened by hand stay open until they're closed by hand.
    /// </summary>
    private void OpenSectionForCurrentPage()
    {
        foreach (var section in Sections.Where(s => s.Items.Any(IsCurrent)))
            expanded.Add(section.Name);
    }

    private bool IsCurrent(NavItem item)
    {
        var path = Nav.ToBaseRelativePath(Nav.Uri).Split('?')[0].Split('#')[0].Trim('/');
        return item.Exact
            ? path.Length == 0
            : path.Equals(item.Href, StringComparison.OrdinalIgnoreCase)
              || path.StartsWith(item.Href + "/", StringComparison.OrdinalIgnoreCase);
    }

    private void Toggle(string name)
    {
        if (!expanded.Remove(name)) expanded.Add(name);
    }
}
