<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>EF Core DbContext, provider switch (SQLite for real data, in-memory for tests), migrations and seed data.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../MyBudget.Domain/MyBudget.Domain.csproj" />
    <ProjectReference Include="../MyBudget.Engines.Paycheck/MyBudget.Engines.Paycheck.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" />
    <!-- Design-time only: this is the `dotnet ef` tooling. Without PrivateAssets it flows into every
         consumer's output and drags Roslyn and MSBuild into the shipped app. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>
